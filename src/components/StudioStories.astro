---
import { ArrowLeft, ArrowRight, Quote } from '@lucide/astro';

// Примеры оформления блока. Студии, логотипы и цитаты вымышлены; описанные возможности сверены с docs/CLAIMS.md.
const backgrounds = [
  { label: 'Фоновое изображение · команда студии' },
  { label: 'Фоновое изображение · работа с альбомом' },
  { label: 'Фоновое изображение · заказы и печать' },
];

const logos = {
  aperture: '<circle cx="24" cy="24" r="13" fill="none" stroke="currentColor" stroke-width="3"/><path d="M24 11l7 13M37 24l-13 7M24 37l-7-13M11 24l13-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>',
  frames: '<rect x="10" y="13" width="20" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="3"/><rect x="18" y="20" width="20" height="16" rx="3" fill="currentColor" opacity=".9"/>',
  north: '<path d="M24 8l3.6 12.4L40 24l-12.4 3.6L24 40l-3.6-12.4L8 24l12.4-3.6z" fill="currentColor"/>',
  line: '<path d="M8 30c5-10 9-10 13 0s8 10 13 0 5-6 6-6" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/>',
  sun: '<circle cx="24" cy="27" r="8" fill="currentColor"/><path d="M24 9v5M12 15l3.5 3.5M36 15l-3.5 3.5M8 27h5M35 27h5M8 37h32" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>',
};

const stories = [
  {
    logo: logos.aperture, tone: 'steel', bg: 0,
    studio: 'Светотень', meta: 'Школьные съёмки · Казань',
    title: 'Сезон выпускных — в одном календаре',
    task: 'Съёмки, школы и контакты организаторов жили в разных таблицах и чатах.',
    change: 'Календарь съёмок и карточки учреждений: команда видит, где и когда работает каждый фотограф.',
    quote: 'Утро начинается не с переписки, а с календаря — сразу видно, кто куда едет.',
    author: 'Марина, руководитель студии',
  },
  {
    logo: logos.frames, tone: 'orange', bg: 1,
    studio: 'Кадр за кадром', meta: 'Детские сады · Екатеринбург',
    title: 'Родители выбирают фото сами',
    task: 'Выбор кадров собирали по сообщениям и переспрашивали каждого родителя.',
    change: 'У каждого ребёнка своя папка: родитель подтверждает её и выбирает кадры по ссылке на альбом.',
    quote: 'Мы перестали угадывать, какое фото кто хотел: выбор приходит уже собранным.',
    author: 'Ольга, фотограф',
  },
  {
    logo: logos.north, tone: 'ink', bg: 2,
    studio: 'Северный свет', meta: 'Студия полного цикла · Мурманск',
    title: 'Заказ собирается из альбома',
    task: 'Форматы и количество отпечатков переписывали из чатов в таблицу вручную.',
    change: 'Родитель выбирает кадры, форматы и количество, а студия получает готовый состав заказа.',
    quote: 'Раньше заказ складывали из трёх переписок. Теперь открываем карточку — и всё на месте.',
    author: 'Денис, администратор студии',
  },
  {
    logo: logos.line, tone: 'sky', bg: 0,
    studio: 'Линия', meta: 'Команда из шести фотографов · Новосибирск',
    title: 'Команда без лишних доступов',
    task: 'На сезон выходят новые фотографы, и всем приходилось давать общий доступ ко всему.',
    change: 'Роли руководителя, администратора, оператора и фотографа: у каждого своя часть работы.',
    quote: 'Новый фотограф в первый же день видит только свои съёмки и не теряется.',
    author: 'Игорь, руководитель студии',
  },
  {
    logo: logos.sun, tone: 'warm', bg: 1,
    studio: 'Тёплый кадр', meta: 'Тематические съёмки · Самара',
    title: 'Цифры сезона на одном экране',
    task: 'Итоги сезона считали в конце года, когда менять что-то было поздно.',
    change: 'Дашборд показывает выручку, средний чек и топ тематик за выбранный период.',
    quote: 'Видно, какие тематики заходят лучше, — по ним и планируем следующий сезон.',
    author: 'Екатерина, владелица студии',
  },
];
const total = String(stories.length).padStart(2, '0');
---
<div class="stories" data-stories>
  <div class="stories-stage">
    <div class="stories-bg" aria-hidden="true">
      {backgrounds.map((b, i) => <div class:list={['ph ph--dark ph--fill ph--corner', { 'is-active': i === 0 }]} data-bg={i}><span>{b.label}</span></div>)}
    </div>
    <div class="stories-top">
      <span class="stories-badge">Примеры · студии вымышлены</span>
      <div class="stories-controls">
        <span class="stories-count" aria-live="polite"><b data-count>01</b> / {total}</span>
        <button type="button" class="stories-btn" data-prev aria-label="Предыдущая история"><ArrowLeft size={20} /></button>
        <button type="button" class="stories-btn" data-next aria-label="Следующая история"><ArrowRight size={20} /></button>
      </div>
    </div>
    <div class="stories-track" data-track tabindex="0" role="region" aria-roledescription="карусель" aria-label="Истории фотостудий, листайте стрелками">
      {stories.map((s, i) => (
        <article class="story" data-story={i} data-bg-index={s.bg} aria-roledescription="слайд" aria-label={`${i + 1} из ${stories.length}: ${s.studio}`}>
          <header class="story-head">
            <span class:list={['story-logo', `tone-${s.tone}`]}><svg viewBox="0 0 48 48" width="30" height="30" aria-hidden="true" set:html={s.logo} /></span>
            <span><strong>{s.studio}</strong><small>{s.meta}</small></span>
            <span class="story-tag">Пример</span>
          </header>
          <div class="story-body">
            <div class="story-case">
              <h3>{s.title}</h3>
              <dl>
                <div><dt>Задача</dt><dd>{s.task}</dd></div>
                <div><dt>В ФотоКонтур</dt><dd>{s.change}</dd></div>
              </dl>
            </div>
            <figure class="story-quote">
              <Quote size={22} aria-hidden="true" />
              <blockquote>{s.quote}</blockquote>
              <figcaption>{s.author}</figcaption>
            </figure>
          </div>
        </article>
      ))}
    </div>
    <div class="stories-dots" aria-hidden="true">
      {stories.map((_, i) => <span class:list={[{ 'is-active': i === 0 }]} />)}
    </div>
  </div>
  <p class="stories-note">Так будут выглядеть истории студий. Названия, логотипы и цитаты здесь вымышлены, вместо фото — заглушки; реальные отзывы появятся только с согласия авторов.</p>
</div>

<style>
.stories-stage{position:relative;isolation:isolate;overflow:hidden;border-radius:28px;background:var(--ink);padding:32px 0 34px;min-height:720px;display:flex;flex-direction:column;justify-content:space-between;gap:40px}
.stories-bg{position:absolute;inset:0;z-index:-1}
.stories-bg .ph{opacity:0;transform:scale(1.07);transition:opacity 1.1s ease,transform 7s ease-out}
.stories-bg .ph.is-active{opacity:1;transform:scale(1)}
.stories-bg:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#17171766 0%,#1717171f 32%,#171717b3 72%,#171717eb 100%)}
.stories-top{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-inline:36px}
.stories-badge{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#ffffff;background:#17171799;backdrop-filter:blur(8px);border:1px solid #ffffff33;border-radius:99px;padding:8px 14px}
.stories-controls{display:flex;align-items:center;gap:10px;color:#ffffff}
.stories-count{font-size:13px;margin-right:8px;font-variant-numeric:tabular-nums;color:#ffffffb3}.stories-count b{color:#ffffff}
.stories-btn{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;border:1px solid #ffffff59;background:#17171766;backdrop-filter:blur(8px);color:#ffffff;transition:background .2s,transform .2s,border-color .2s}
.stories-btn:hover:not(:disabled){background:#ffffff;color:var(--ink);transform:translateY(-2px)}
.stories-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:36px;padding:8px 36px 10px;scrollbar-width:none;cursor:grab;overscroll-behavior-x:contain}
.stories-track::-webkit-scrollbar{display:none}
.stories-track.is-dragging{cursor:grabbing;scroll-snap-type:none;user-select:none}
.stories-track:focus-visible{outline:3px solid var(--sky);outline-offset:-3px}
.story{flex:0 0 min(720px,82%);scroll-snap-align:start;background:#ffffffef;backdrop-filter:blur(14px);border-radius:22px;padding:26px 28px 28px;color:var(--ink);box-shadow:0 20px 50px -24px #00000099;opacity:.6;transform:translateY(0) scale(.97);transform-origin:left bottom;transition:opacity .45s,transform .45s,box-shadow .3s}
.story.is-active{opacity:1;transform:scale(1)}
.story:hover{box-shadow:0 26px 60px -22px #000000aa}
.stories:not(.is-visible) .story{opacity:0;transform:translateY(36px) scale(.97)}
.story-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.story-head strong{display:block;font-size:18px;letter-spacing:-.02em}.story-head small{display:block;font-size:12px;color:var(--muted)}
.story-logo{display:grid;place-items:center;width:52px;height:52px;border-radius:15px;transition:transform .5s}
.story.is-active .story-logo{transform:rotate(-6deg)}
.tone-steel{background:#ebebeb;color:var(--steel)}.tone-orange{background:#ebebeb;color:var(--orange)}.tone-ink{background:var(--ink);color:#ffffff}.tone-sky{background:#e9e9e9;color:#636363}.tone-warm{background:#f0f0f0;color:#828282}
.story-tag{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);border:1px dashed #b9b9b9;border-radius:99px;padding:5px 10px}
.story-body{display:grid;grid-template-columns:1.15fr 1fr;gap:28px;margin-top:20px}
.story-case h3{font-size:24px}
.story dl{margin:16px 0 0;display:grid;gap:12px}
.story dt{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:3px}
.story dd{margin:0;font-size:14px;line-height:1.55}
.story-quote{background:#f3f3f3;border-radius:16px;padding:20px 20px 18px;display:flex;flex-direction:column;gap:12px}
.story-quote svg{color:var(--steel)}
.story-quote blockquote{margin:0;font-size:17px;line-height:1.5;letter-spacing:-.02em;font-weight:600}
.story-quote figcaption{margin-top:auto;font-size:12px;color:var(--muted)}
.stories-dots{display:flex;gap:6px;padding-inline:36px;margin-top:-18px}
.stories-dots span{height:4px;width:18px;border-radius:4px;background:#ffffff59;transition:width .35s,background .35s}
.stories-dots span.is-active{width:42px;background:#ffffff}
.stories-note{font-size:12px;line-height:1.6;color:var(--muted);margin-top:16px}
@media(max-width:1100px){.stories-stage{min-height:680px}.story{flex-basis:88%}}@media(max-width:900px){.story-body{grid-template-columns:1fr;gap:18px}}
@media(max-width:760px){
  .stories-stage{border-radius:22px;padding:20px 0 24px;min-height:0;gap:150px}
  .stories-top{padding-inline:18px}.stories-badge{font-size:10px;padding:7px 11px}
  .stories-count{display:none}.stories-btn{width:40px;height:40px}
  .stories-track{padding-inline:18px;scroll-padding-inline:18px;gap:12px}
  .story{flex-basis:88%;padding:20px}.story-head strong{font-size:16px}.story-logo{width:44px;height:44px;border-radius:13px}
  .story-tag{display:none}.story-case h3{font-size:21px}.story-quote{padding:16px}.story-quote svg{display:none}.story-quote blockquote{font-size:15px}.story dl{gap:10px}
  .stories-dots{padding-inline:18px;margin-top:-12px}
}
@media(prefers-reduced-motion:reduce){.stories:not(.is-visible) .story{opacity:.6;transform:none}.stories-bg .ph{transform:none}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-stories]').forEach(root=>{
    const track=root.querySelector<HTMLElement>('[data-track]')!;
    const cards=[...root.querySelectorAll<HTMLElement>('[data-story]')];
    const bgs=[...root.querySelectorAll<HTMLElement>('[data-bg]')];
    const dots=[...root.querySelectorAll<HTMLElement>('.stories-dots span')];
    const count=root.querySelector<HTMLElement>('[data-count]')!;
    const prev=root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next=root.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active=0,target=0,settle=0;

    function setActive(i:number){
      active=i;
      cards.forEach((c,n)=>c.classList.toggle('is-active',n===i));
      dots.forEach((d,n)=>d.classList.toggle('is-active',n===i));
      const bg=Number(cards[i].dataset.bgIndex);
      bgs.forEach((b,n)=>b.classList.toggle('is-active',n===bg));
      count.textContent=String(i+1).padStart(2,'0');
      prev.disabled=i===0;
      next.disabled=i===cards.length-1;
    }
    function goTo(i:number){
      target=Math.max(0,Math.min(cards.length-1,i));
      const card=cards[target];
      track.scrollTo({left:card.offsetLeft-cards[0].offsetLeft,behavior:reduce?'auto':'smooth'});
    }
    // Активная карточка — ближайшая к левому краю ленты.
    function sync(){
      const x=track.scrollLeft;
      let best=0,dist=Infinity;
      cards.forEach((c,n)=>{const d=Math.abs(c.offsetLeft-cards[0].offsetLeft-x);if(d<dist){dist=d;best=n}});
      if(track.scrollLeft+track.clientWidth>=track.scrollWidth-4)best=cards.length-1;
      if(best!==active)setActive(best);
    }
    let ticking=false;
    // target — карточка, к которой уже едет лента: быстрые клики не теряются.
    track.addEventListener('scroll',()=>{
      if(!ticking){ticking=true;requestAnimationFrame(()=>{sync();ticking=false})}
      clearTimeout(settle);settle=window.setTimeout(()=>{sync();target=active},160);
    },{passive:true});
    prev.addEventListener('click',()=>goTo(target-1));
    next.addEventListener('click',()=>goTo(target+1));
    track.addEventListener('keydown',e=>{
      if(e.key==='ArrowRight'){e.preventDefault();goTo(target+1)}
      if(e.key==='ArrowLeft'){e.preventDefault();goTo(target-1)}
    });
    cards.forEach((c,n)=>c.addEventListener('click',()=>{if(!moved&&n!==active)goTo(n)}));

    // Перетаскивание мышью; на сенсорных экранах работает нативная прокрутка.
    let startX=0,startScroll=0,startIndex=0,dragging=false,moved=false;
    track.addEventListener('pointerdown',e=>{
      if(e.pointerType!=='mouse'||e.button!==0)return;
      dragging=true;moved=false;startX=e.clientX;startScroll=track.scrollLeft;startIndex=active;
    });
    window.addEventListener('pointermove',e=>{
      if(!dragging)return;
      const dx=e.clientX-startX;
      if(!moved&&Math.abs(dx)>5){moved=true;track.classList.add('is-dragging')}
      if(moved)track.scrollLeft=startScroll-dx;
    });
    window.addEventListener('pointerup',()=>{
      if(!dragging)return;
      dragging=false;
      if(moved){
        track.classList.remove('is-dragging');
        const dx=track.scrollLeft-startScroll;
        goTo(Math.abs(dx)>60?startIndex+(dx>0?1:-1):startIndex);
        setTimeout(()=>{moved=false},0);
      }
    });

    setActive(0);
    if('IntersectionObserver' in window&&!reduce){
      cards.forEach((c,n)=>{c.style.transitionDelay=`${n*90}ms`});
      const io=new IntersectionObserver(entries=>{
        if(entries.some(en=>en.isIntersecting)){
          root.classList.add('is-visible');
          setTimeout(()=>cards.forEach(c=>{c.style.transitionDelay=''}),900);
          io.disconnect();
        }
      },{threshold:.15});
      io.observe(root);
    }else root.classList.add('is-visible');
  });
</script>
