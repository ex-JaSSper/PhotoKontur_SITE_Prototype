---
import { ArrowUpRight, Play } from '@lucide/astro';
const { title='Ваш следующий сезон. В одном рабочем пространстве.', text='Расскажите о своей студии и задачах. Начните знакомство с ФотоКонтур с заявки на модерацию.' }=Astro.props;
---
<section class="cta section"><div class="wrap cta-inner"><div><span class="eyebrow">Начнём с вашей студии</span><h2>{title}</h2><p>{text}</p><div class="actions"><a class="btn" href="#apply">Заявка на модерацию<ArrowUpRight size={20}/></a>{Astro.url.pathname!=="/how-it-works/"&&<a class="text-link" href="/how-it-works/"><Play size={17}/>Сначала посмотреть демо</a>}</div></div><div class="orbit" aria-hidden="true"><span>ФК</span><i></i><i></i></div></div></section>
<style>.cta{background:#e3e3e3;overflow:hidden}.cta-inner{display:grid;grid-template-columns:1.6fr 1fr;align-items:center;gap:70px}.cta h2{max-width:740px}.cta p{margin-top:24px;max-width:560px;color:#505050}.orbit{width:300px;height:300px;border:1px solid #9f9f9f;border-radius:50%;position:relative;justify-self:center;display:grid;place-items:center}.orbit:before,.orbit:after{content:'';position:absolute;border:1px solid #9f9f9f;border-radius:50%;width:380px;height:180px;transform:rotate(-35deg)}.orbit:after{transform:rotate(35deg)}.orbit span{width:132px;height:132px;border-radius:32px;background:var(--ink);color:white;display:grid;place-items:center;font-size:48px;font-weight:700;z-index:1}.orbit i{position:absolute;width:18px;height:18px;background:var(--steel);border-radius:50%;right:13px;top:62px}.orbit i:last-child{left:24px;top:auto;bottom:53px;background:var(--orange);width:11px;height:11px}@media(max-width:900px){.cta-inner{grid-template-columns:1fr}.orbit{display:none}}</style>
