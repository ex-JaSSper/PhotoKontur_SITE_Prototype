---
// Блок на странице «Как это работает»: работа в сервисе бесплатна для студии,
// онлайн-оплата (эквайринг) уже настроена, выплаты на расчётный счёт — ежедневно.
// Кто оплачивает эквайринг, прямо не называем.
import { BadgeCheck, CreditCard, Landmark } from '@lucide/astro';
const items = [
  { icon: BadgeCheck, t: 'Работа в сервисе бесплатна', p: 'Студия не платит за подключение и обслуживание: ни абонентской платы, ни процента с заказов.' },
  { icon: CreditCard, t: 'Онлайн-оплата уже настроена', p: 'Родители оплачивают заказы картой или через СБП в своём кабинете. Подключать эквайринг и договариваться с банком не нужно.' },
  { icon: Landmark, t: 'Выплаты каждый день', p: 'Деньги за оплаченные заказы ежедневно поступают на расчётный счёт студии.' },
];
---
<section class="section wrap pay" aria-labelledby="pay-title">
  <div class="pay-head">
    <span class="eyebrow">Условия для студии</span>
    <h2 id="pay-title">Работа в сервисе бесплатна.<br/>Деньги приходят каждый день.</h2>
    <p class="lead">Онлайн-оплата заказов работает сразу после подключения, а выплаты на расчётный счёт студии проходят ежедневно.</p>
  </div>
  <ul class="pay-grid">
    {items.map((x) => (
      <li><span class="pay-icon"><x.icon size={24}/></span><h3>{x.t}</h3><p>{x.p}</p></li>
    ))}
  </ul>
  <p class="pay-note">Наличные, принятые в учреждении, тоже отражаются в сервисе. Условия подключения фиксируются в договоре.</p>
</section>

<style>
.pay-head{max-width:820px;display:grid;gap:16px}
.pay-head h2{font-size:clamp(28px,2.92vw,44px)}
.pay-grid{list-style:none;margin:32px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.pay-grid li{padding:26px;border-radius:20px;background:var(--paper);border:1px solid var(--line);display:grid;gap:10px;align-content:start}
.pay-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--bg);color:var(--ink)}
.pay-grid h3{font-size:20px;letter-spacing:-.02em;margin-top:6px}
.pay-grid p{font-size:15px;line-height:1.55;color:var(--muted)}
.pay-note{margin-top:20px;font-size:14px;color:var(--muted)}
@media(max-width:900px){.pay-grid{grid-template-columns:1fr}}
</style>
