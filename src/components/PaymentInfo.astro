---
// «Бесплатное использование и выплаты» (главная): сервис бесплатен для фотографа, онлайн-оплата
// с платёжной комиссией, выплата на следующий день после оплаты родителем. Сравнение с привычной схемой.
import { BadgeCheck, CreditCard, Landmark } from '@lucide/astro';
const items = [
  { icon: BadgeCheck, t: 'Бесплатно для фотографа', p: 'Подключение и работа в сервисе ничего не стоят: нет абонентской платы и платы за подключение.' },
  { icon: CreditCard, t: 'Онлайн-оплата уже подключена', p: 'Родители платят картой или через СБП. За онлайн-платёж действует комиссия платёжной системы — её размер виден при оформлении заказа.' },
  { icon: Landmark, t: 'Деньги на следующий день', p: 'Оплата за заказ поступает на расчётный счёт студии на следующий день после того, как родитель оплатил.' },
];
---
<section class="section wrap pay" id="payments" aria-labelledby="pay-title">
  <div class="pay-head">
    <span class="eyebrow">Деньги</span>
    <h2 id="pay-title">Сервис бесплатный.<br/><em>Деньги — на следующий день.</em></h2>
  </div>
  <div class="pay-compare">
    <div><small>Как обычно</small><p>Съёмка, пробники, сбор заказов, печать, сбор денег через воспитателей. Деньги приходят только в самом конце.</p></div>
    <div class="pay-compare-new"><small>С ФотоКонтур</small><p>Родитель оплатил заказ онлайн — на следующий день деньги уже на счёте студии.</p></div>
  </div>
  <ul class="pay-grid">
    {items.map((x) => (
      <li><span class="pay-icon"><x.icon size={24}/></span><h3>{x.t}</h3><p>{x.p}</p></li>
    ))}
  </ul>
  <p class="pay-note">Наличные, принятые в учреждении, тоже отражаются в сервисе. Условия подключения фиксируются в договоре.</p>
</section>

<style>
.pay-head{max-width:820px;display:grid;gap:16px}
.pay-head h2{font-size:clamp(28px,2.92vw,44px)}
.pay-head em{font-style:normal;color:#5c5c5c}
.pay-compare{margin-top:32px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.pay-compare div{padding:24px 26px;border-radius:20px;border:1px solid var(--line);display:grid;gap:8px}
.pay-compare small{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pay-compare p{font-size:18px;line-height:1.45;letter-spacing:-.01em}
.pay-compare-new{background:var(--ink);color:#fff;border-color:var(--ink)!important}
.pay-compare-new small{color:#bdbdbd}
.pay-grid{list-style:none;margin:16px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.pay-grid li{padding:26px;border-radius:20px;background:var(--paper);border:1px solid var(--line);display:grid;gap:10px;align-content:start}
.pay-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--bg);color:var(--ink)}
.pay-grid h3{font-size:20px;letter-spacing:-.02em;margin-top:6px}
.pay-grid p{font-size:15px;line-height:1.55;color:var(--muted)}
.pay-note{margin-top:20px;font-size:14px;color:var(--muted)}
@media(max-width:900px){.pay-grid,.pay-compare{grid-template-columns:1fr}}
</style>
