---
// Выезжающие справа панели с формами. Открываются любой ссылкой href="#apply" или href="#question"
// (кнопки «Заявка на модерацию», «Задать вопрос», «Запросить звонок»). Нативный <dialog>:
// фокус внутри, Esc закрывает, фокус возвращается на кнопку.
import { X } from '@lucide/astro';
import LeadForm from './LeadForm.astro';
---
<dialog class="drawer" id="drawer-apply" aria-labelledby="drawer-apply-title" data-drawer="apply">
  <div class="drawer-head">
    <div><h2 id="drawer-apply-title">Заявка на модерацию</h2><p>Расскажите о себе и студии — команда ФотоКонтур свяжется с вами.</p></div>
    <button type="button" class="drawer-close" data-drawer-close aria-label="Закрыть"><X size={20}/></button>
  </div>
  <div class="drawer-body"><LeadForm kind="apply" id="drawer-apply-form" /></div>
</dialog>

<dialog class="drawer" id="drawer-question" aria-labelledby="drawer-question-title" data-drawer="question">
  <div class="drawer-head">
    <div><h2 id="drawer-question-title">Задать вопрос</h2><p>Оставьте вопрос — мы ответим на почту.</p></div>
    <button type="button" class="drawer-close" data-drawer-close aria-label="Закрыть"><X size={20}/></button>
  </div>
  <div class="drawer-body"><LeadForm kind="question" id="drawer-question-form" /></div>
</dialog>

<style>
.drawer{position:fixed;inset:0 0 0 auto;margin:0;width:min(560px,100vw);max-width:100vw;height:100dvh;max-height:100dvh;padding:0;border:0;border-radius:24px 0 0 24px;background:var(--paper);color:var(--ink);overflow:hidden;
  transform:translateX(100%);transition:transform .38s cubic-bezier(.2,.8,.2,1),overlay .38s allow-discrete,display .38s allow-discrete}
.drawer[open]{transform:none;display:flex;flex-direction:column}
@starting-style{.drawer[open]{transform:translateX(100%)}}
.drawer::backdrop{background:rgba(20,20,20,0);transition:background .38s,overlay .38s allow-discrete,display .38s allow-discrete}
.drawer[open]::backdrop{background:rgba(20,20,20,.55)}
@starting-style{.drawer[open]::backdrop{background:rgba(20,20,20,0)}}
.drawer-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:28px 32px 20px;border-bottom:1px solid var(--line)}
.drawer-head h2{font-size:28px;letter-spacing:-.03em}
.drawer-head p{margin-top:6px;font-size:15px;color:var(--muted)}
.drawer-close{flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer}
.drawer-close:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.drawer-body{flex:1;overflow:auto;overscroll-behavior:contain;padding:24px 32px calc(32px + env(safe-area-inset-bottom))}
@media(max-width:640px){.drawer{border-radius:0}.drawer-head{padding:20px 20px 16px}.drawer-body{padding:20px}}
@media(prefers-reduced-motion:reduce){.drawer,.drawer::backdrop{transition:none}}
</style>

<script>
  const drawers = new Map([...document.querySelectorAll<HTMLDialogElement>('[data-drawer]')].map((d) => [d.dataset.drawer!, d]));
  let opener: HTMLElement | null = null;
  const open = (kind: string, from?: HTMLElement | null) => {
    const d = drawers.get(kind); if (!d) return;
    drawers.forEach((x) => x.open && x.close());
    opener = from ?? (document.activeElement as HTMLElement);
    d.showModal();
    d.querySelector<HTMLElement>('input:not([type=checkbox]),textarea')?.focus();
    document.documentElement.style.overflow = 'hidden';
  };
  drawers.forEach((d) => {
    d.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      if (location.hash === '#apply' || location.hash === '#question') history.replaceState(null, '', location.pathname + location.search);
      opener?.focus();
    });
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    d.querySelector('[data-drawer-close]')!.addEventListener('click', () => d.close());
  });
  // Любая ссылка #apply / #question открывает панель (в том числе ссылки внутри статей и подвала).
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href$="#apply"], a[href$="#question"]');
    if (!a) return;
    e.preventDefault();
    open(a.hash.slice(1), a);
  });
  // Прямая ссылка на сайт с #apply или #question
  if (location.hash === '#apply' || location.hash === '#question') open(location.hash.slice(1));
</script>
