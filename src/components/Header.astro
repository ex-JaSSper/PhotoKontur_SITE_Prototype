---
import { ArrowUpRight, Menu, X } from '@lucide/astro';
const path=Astro.url.pathname;
const links=[['/how-it-works/','Как это работает'],['/security/','Безопасность'],['/reviews/','Отзывы'],['/blog/','Блог'],['/faq/','FAQ']];
---
<header class="header"><div class="wrap header-inner"><a href="/" class="logo" aria-label="ФотоКонтур — главная"><b>ФОТО<span></span></b><span>КОНТУР</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Открыть меню"><Menu size={24}/><X size={24} class="close-icon"/></button><nav id="navigation" aria-label="Основная навигация">{links.map(([href,label])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}<a class="btn nav-cta" href="#apply">Заявка на модерацию<ArrowUpRight size={17}/></a></nav></div></header>
<style>.header{position:sticky;top:0;z-index:50;background:rgba(243,243,243,.94);backdrop-filter:blur(15px);border-bottom:1px solid var(--line)}.header-inner{height:88px;display:flex;align-items:center;justify-content:space-between;gap:30px}.logo{display:flex;align-items:center;gap:5px;font-size:23px;letter-spacing:-1px;white-space:nowrap}.logo b{color:white;background:var(--ink);padding:1px 8px;border-radius:8px;position:relative}.logo b span{width:5px;height:5px;border-radius:50%;background:var(--orange);position:absolute;top:5px;right:4px}.logo>span{font-weight:400}nav{display:flex;align-items:center;gap:27px}nav>a{font-size:13px;font-weight:700}nav>a:not(.btn):hover,nav>a[aria-current=page]{color:#616161}.nav-cta{min-height:46px;padding:12px 17px}.menu-toggle{display:none;background:none;border:0;padding:10px}.close-icon{display:none}@media(max-width:1320px){nav{gap:16px}nav>a:not(.nav-cta){font-size:14px}}@media(max-width:1100px){nav{gap:18px}.logo{font-size:20px}.header-inner{gap:16px}}@media(max-width:1180px){.header-inner{height:72px}.menu-toggle{display:flex;margin-left:auto}nav{display:none;position:absolute;top:71px;left:0;width:100%;background:var(--bg);padding:22px;box-shadow:0 20px 30px #17171715;align-items:stretch;gap:8px}nav>a{padding:13px;font-size:16px}nav.open{display:flex;flex-direction:column}.menu-toggle[aria-expanded=true] svg:first-child{display:none}.menu-toggle[aria-expanded=true] .close-icon{display:block}}</style>
<script>const trigger=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector('#navigation');function close(){trigger?.setAttribute('aria-expanded','false');trigger?.setAttribute('aria-label','Открыть меню');nav?.classList.remove('open')}trigger?.addEventListener('click',()=>{const open=trigger.getAttribute('aria-expanded')!=='true';trigger.setAttribute('aria-expanded',String(open));trigger.setAttribute('aria-label',open?'Закрыть меню':'Открыть меню');nav?.classList.toggle('open',open)});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&trigger?.getAttribute('aria-expanded')==='true'){close();trigger.focus()}});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));</script>
