---
// «Как это работает — кратко»: три шага от съёмки до оплаченного заказа. Подробности — в демо.
import { Camera, Upload, CreditCard, ArrowRight, ArrowUpRight } from '@lucide/astro';
const steps = [
  { icon: Camera, t: 'Проводите съёмку', p: 'Снимаете в саду или школе так же, как всегда. В самой съёмке ничего менять не нужно.' },
  { icon: Upload, t: 'Загружаете фотографии', p: 'Сервис раскладывает кадры по альбомам детей и открывает их родителям.' },
  { icon: CreditCard, t: 'Родители выбирают и оплачивают', p: 'Смотрят снимки, выбирают фотографии и размеры печати, оплачивают онлайн.' },
];
---
<section class="section wrap brief" aria-labelledby="brief-title">
  <div class="brief-head">
    <span class="eyebrow">Как это работает</span>
    <h2 id="brief-title">Три шага от съёмки<br/><em>до оплаченного заказа.</em></h2>
  </div>
  <ol class="brief-steps">
    {steps.map((s, i) => (
      <li>
        <span class="brief-icon"><s.icon size={26}/></span>
        <h3>{s.t}</h3>
        <p>{s.p}</p>
        {i < steps.length - 1 && <ArrowRight class="brief-arrow" size={22} aria-hidden="true"/>}
      </li>
    ))}
  </ol>
  <div class="brief-foot">
    <p>Дальше заказы собираются и обрабатываются сами, а родители получают уведомления.</p>
    <a class="text-link" href="/how-it-works/">Посмотреть подробно в демо<ArrowUpRight size={18}/></a>
  </div>
</section>

<style>
.brief-head{display:grid;gap:14px;max-width:760px}
.brief-head h2{font-size:clamp(28px,2.92vw,44px)}
.brief-head em{font-style:normal;color:#5c5c5c}
.brief-steps{list-style:none;margin:32px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.brief-steps li{position:relative;display:grid;gap:10px;align-content:start;padding:26px;background:var(--paper);border:1px solid var(--line);border-radius:20px}
.brief-icon{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--bg);color:var(--ink);margin-bottom:6px}
.brief-steps h3{font-size:20px;letter-spacing:-.02em}
.brief-steps p{font-size:15px;line-height:1.55;color:var(--muted)}
.brief-arrow{position:absolute;right:-19px;top:40px;z-index:1;padding:4px;width:30px;height:30px;border-radius:50%;background:var(--ink);color:#fff}
.brief-foot{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:22px}
.brief-foot p{font-size:16px;color:var(--muted);max-width:640px}
@media(max-width:900px){.brief-steps{grid-template-columns:1fr}.brief-arrow{display:none}}
</style>
