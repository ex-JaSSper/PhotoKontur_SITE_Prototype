---
// Блок формы на главной: выбор темы (заявка / звонок / вопрос) и соответствующая форма.
import { ArrowUpRight, Check, MessageCircleMore, PhoneCall, ShieldCheck } from '@lucide/astro';
import LeadForm from './LeadForm.astro';
const topics = [
  { value: 'apply', icon: ShieldCheck, title: 'Оставить заявку', text: 'Подключить студию к ФотоКонтур' },
  { value: 'call', icon: PhoneCall, title: 'Заказать звонок', text: 'Перезвоним и разберём ваш процесс' },
  { value: 'question', icon: MessageCircleMore, title: 'Задать вопрос', text: 'О возможностях, ролях и условиях' },
] as const;
---
<section class="section contact" id="contact" aria-labelledby="contact-title" data-contact>
  <div class="wrap contact-panel">
    <div class="contact-side">
      <span class="eyebrow">Связаться с командой</span>
      <h2 id="contact-title">Расскажите<br/>о вашей студии.</h2>
      <p>Выберите тему — и оставьте контакт. Команда ФотоКонтур ответит и предложит следующий шаг.</p>
      <fieldset class="contact-topics">
        <legend class="sr-only">Тема обращения</legend>
        {topics.map((t, i) => (
          <label class="topic">
            <input type="radio" name="contact-topic" value={t.value} checked={i === 0} />
            <span class="topic-icon"><t.icon size={20} /></span>
            <span><strong>{t.title}</strong><small>{t.text}</small></span>
            <span class="topic-check" aria-hidden="true"><Check size={14} /></span>
          </label>
        ))}
      </fieldset>
      <p class="contact-side-note">Сначала хотите посмотреть сервис? <a href="/how-it-works/">Открыть демо<ArrowUpRight size={15} /></a></p>
    </div>
    <div class="contact-main">
      <div data-topic-panel="apply"><LeadForm kind="apply" id="contact-form" /></div>
      <div data-topic-panel="call" hidden><LeadForm kind="call" id="contact-call" /></div>
      <div data-topic-panel="question" hidden><LeadForm kind="question" id="contact-question" /></div>
    </div>
  </div>
</section>

<style>
.contact-panel{display:grid;grid-template-columns:.9fr 1.25fr;border-radius:28px;overflow:hidden;background:var(--paper);border:1px solid var(--line);box-shadow:0 30px 70px -50px #17171780}
.contact-side{position:relative;isolation:isolate;padding:32px 44px;background:var(--ink);color:#ffffff;overflow:hidden;display:flex;flex-direction:column;gap:16px}
.contact-side .eyebrow{color:#cfcfcf}
.contact-side .eyebrow:before{background:var(--sky)}
.contact-side h2{font-size:clamp(28px,2.31vw,33px);color:#ffffff}
.contact-side p{color:#c9c9c9;line-height:1.6}
.contact-topics{border:0;margin:8px 0 0;padding:0;display:grid;gap:10px}
.topic{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:16px;border:1px solid #3a3a3a;background:#1f1f1f;cursor:pointer;transition:border-color .2s,background .2s}
.topic:hover{border-color:#6b6b6b}
.topic input{position:absolute;opacity:0;pointer-events:none}
.topic-icon{flex:none;display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#2e2e2e;color:#ffffff}
.topic strong{display:block;font-size:15px;color:#ffffff}
.topic small{display:block;font-size:13px;color:#a3a3a3;margin-top:2px}
.topic-check{margin-left:auto;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;border:1px solid #555555;color:transparent}
.topic:has(input:checked){background:#ffffff;border-color:#ffffff}
.topic:has(input:checked) strong{color:#141414}
.topic:has(input:checked) small{color:#5c5c5c}
.topic:has(input:checked) .topic-icon{background:#f0f0f0;color:#141414}
.topic:has(input:checked) .topic-check{background:#141414;border-color:#141414;color:#ffffff}
.topic:has(input:focus-visible){outline:2px solid #ffffff;outline-offset:2px}
.contact-side-note{font-size:13px!important;margin-top:auto}
.contact-side-note a{display:inline-flex;align-items:center;gap:4px;color:#ffffff;font-weight:700;border-bottom:1px solid #ffffff80}
.contact-main{padding:32px 48px}
@media(max-width:900px){.contact-panel{grid-template-columns:1fr}.contact-side-note{margin-top:8px}}
@media(max-width:760px){.contact-side{padding:30px 22px}.contact-main{padding:26px 20px}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact]').forEach((root) => {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-topic-panel]')];
    root.querySelectorAll<HTMLInputElement>('input[name="contact-topic"]').forEach((r) =>
      r.addEventListener('change', () => panels.forEach((p) => (p.hidden = p.dataset.topicPanel !== r.value))));
  });
</script>
