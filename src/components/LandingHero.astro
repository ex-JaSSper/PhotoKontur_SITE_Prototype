---
import {ArrowUpRight, ArrowRight, MapPin, Sparkles, LayoutDashboard} from '@lucide/astro';
---
<section class="landing-hero" aria-labelledby="landing-title">
  <div class="landing-hero-media" aria-hidden="true"><div class="ph ph--dark ph--fill ph--top"><span>Фоновое изображение · фотограф в студии</span></div></div>
  <div class="wrap landing-hero-inner">
    <div class="landing-hero-main">
      <h1 id="landing-title">Сюжетные съёмки<br/><em>в садах и школах</em></h1>
      <p>Съёмки, альбомы, заказы родителей и деньги — в одной системе. Вы снимаете, остальное ведёт ФотоКонтур.</p>
      <div class="landing-actions"><a class="landing-primary" href="#apply">Оставить заявку <ArrowUpRight size={20}/></a><a class="landing-secondary" href="/how-it-works/">Смотреть демо <ArrowRight size={19}/></a></div>
    </div>
    <div class="landing-highlights" aria-label="ФотоКонтур для фотостудий">
      <div class="landing-highlight"><MapPin size={26}/><div><small>География</small><strong>Для студий по всей России</strong><span>Рабочий процесс доступен команде и клиентам онлайн.</span></div></div>
      <a class="landing-highlight" href="#vision"><Sparkles size={27}/><div><small>Главное преимущество</small><strong>AI-распознавание лиц</strong><span>Сервис сам раскладывает кадры по персональным альбомам детей.</span></div><ArrowUpRight class="highlight-arrow" size={18}/></a>
      <div class="landing-highlight"><LayoutDashboard size={27}/><div><small>Рабочее пространство</small><strong>Вся работа — в одном контуре</strong><span>Инструменты студии и область родителей для выбора фотографий собраны на одной платформе.</span></div></div>
    </div>
  </div>
</section>
<style>
.landing-hero{position:relative;isolation:isolate;min-height:max(760px,calc(100svh - 88px));color:#ffffff;background:#131313;overflow:hidden}
.landing-hero-media{position:absolute;inset:0;z-index:-2}
.landing-hero-media img{width:100%;height:100%;object-fit:cover;object-position:center}
.landing-hero:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#121212 0%,#121212ed 26%,#12121289 51%,#1212121f 76%),linear-gradient(0deg,#121212ed 0%,transparent 29%);pointer-events:none}
.landing-hero-inner{min-height:inherit;display:flex;flex-direction:column;justify-content:space-between;gap:70px;padding-block:57px 37px}
.landing-hero-main{max-width:740px;animation:hero-arrive .7s ease-out both}
.landing-kicker{display:inline-flex;align-items:center;gap:12px;border:1px solid #d4d4d45e;border-radius:99px;padding:9px 15px;color:#e6e6e6;background:#2f2f2f70;backdrop-filter:blur(12px);font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:800}
.landing-kicker i{display:block;width:7px;height:7px;border-radius:50%;background:#d0d0d0;box-shadow:0 0 0 5px #d0d0d02a}
.landing-hero h1{font-size:clamp(41px,3.97vw,63px);line-height:.98;letter-spacing:-.068em;font-weight:650;margin-top:37px;text-wrap:balance}
.landing-hero h1 em{font-style:normal;color:#d2d2d2}
.landing-hero-main>p{font-size:19px;line-height:1.65;color:#e9e9e9;max-width:625px;margin-top:35px;text-wrap:pretty}
.landing-actions{display:flex;align-items:center;gap:13px;flex-wrap:wrap;margin-top:38px}
.landing-actions a{min-height:59px;padding:15px 23px;border-radius:11px;display:inline-flex;align-items:center;justify-content:center;gap:16px;font-size:14px;font-weight:800;transition:transform .25s,background .25s,border-color .25s}
.landing-actions a:hover{transform:translateY(-3px)}
.landing-primary{background:#828282;color:#131313;box-shadow:0 12px 32px #82828233}
.landing-primary:hover{background:#9d9d9d}
.landing-secondary{border:1px solid #e3e3e39e;background:#2727278a;color:white;backdrop-filter:blur(10px)}
.landing-secondary:hover{background:#424242;border-color:white}
.landing-highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border:1px solid #cecece61;border-radius:19px;background:#232323ae;backdrop-filter:blur(15px);overflow:hidden}
.landing-highlight{position:relative;display:flex;align-items:flex-start;gap:17px;min-height:137px;padding:26px 26px 21px}
.landing-highlight+.landing-highlight{border-left:1px solid #cecece44}
.landing-highlight>svg{color:#cccccc;flex:none;margin-top:5px}
.landing-highlight small{display:block;color:#bebebe;font-size:10px;letter-spacing:.11em;text-transform:uppercase;font-weight:800;margin-bottom:5px}
.landing-highlight strong{display:block;color:white;font-size:17px;line-height:1.35}
.landing-highlight span{display:block;color:#cacaca;font-size:12px;line-height:1.5;margin-top:7px}
.landing-highlight[href]{transition:background .2s}
.landing-highlight[href]:hover{background:#5656567d}
.landing-highlight .highlight-arrow{position:absolute;right:20px;top:22px;width:16px;color:#dfdfdf}
.landing-photo-note{position:absolute;right:48px;top:18px;font-size:9px;color:#d3d3d39e}
@keyframes hero-arrive{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@media(max-width:1100px){.landing-hero{min-height:760px}.landing-hero-inner{padding-block:43px 32px;gap:55px}.landing-hero h1{font-size:clamp(38px,4.34vw,52px)}.landing-hero-main>p{font-size:17px;max-width:540px}.landing-highlight{padding:20px 17px;gap:12px;min-height:130px}.landing-highlight strong{font-size:14px}.landing-highlight span{font-size:11px}}
@media(max-width:760px){.landing-hero{min-height:0}.landing-hero-media img{object-position:66% center}.landing-hero:before{background:linear-gradient(90deg,#121212e8 0%,#1212129c 70%,#12121267 100%),linear-gradient(0deg,#121212 0%,#121212e8 25%,#12121247 70%)}.landing-hero-inner{gap:66px;padding-block:37px 32px}.landing-kicker{font-size:9px;letter-spacing:.05em;max-width:100%;line-height:1.3}.landing-hero h1{font-size:clamp(31px,6.82vw,48px);margin-top:28px}.landing-hero-main>p{font-size:16px;line-height:1.6;margin-top:25px}.landing-actions{gap:10px;margin-top:29px}.landing-actions a{font-size:13px;padding:13px 17px;min-height:53px}.landing-highlights{grid-template-columns:1fr;background:#232323e3}.landing-highlight{min-height:0;padding:16px 20px;gap:14px}.landing-highlight+.landing-highlight{border-left:0;border-top:1px solid #cecece44}.landing-highlight strong{font-size:15px}.landing-highlight span{font-size:11px;margin-top:3px}.landing-highlight>svg{width:22px;height:22px}.landing-photo-note{position:relative;top:auto;right:auto;text-align:center;padding-bottom:12px}}
@media(max-width:430px){.landing-hero h1{font-size:clamp(29px,7.13vw,35px)}.landing-actions{display:grid;grid-template-columns:1fr}.landing-actions a{justify-content:space-between}.landing-hero-inner{gap:50px}}
@media(prefers-reduced-motion:reduce){.landing-hero-main{animation:none}}
</style>
