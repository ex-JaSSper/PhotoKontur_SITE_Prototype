---
// Формы обращения. kind="apply" — заявка на модерацию, kind="question" — вопрос и телефон.
// Используются в выезжающей панели (LeadDrawer) и в блоке формы на главной.
import { Send, Check } from '@lucide/astro';
interface Props { kind: 'apply' | 'question' | 'call'; id: string }
const { kind, id } = Astro.props;
const btn = kind === 'apply' ? 'Отправить заявку' : kind === 'call' ? 'Заказать звонок' : 'Отправить вопрос';
---
<div class="lf" data-lead-form={kind}>
  <form class="lf-form" id={id} novalidate>
    {kind === 'apply' ? (
      <>
        <div class="lf-row lf-row-3">
          <label>Фамилия *<input name="lastName" required autocomplete="family-name" maxlength="80" /></label>
          <label>Имя *<input name="firstName" required autocomplete="given-name" maxlength="80" /></label>
          <label>Отчество<input name="middleName" autocomplete="additional-name" maxlength="80" placeholder="Если есть" /></label>
        </div>
        <div class="lf-row">
          <label>Город *<input name="city" required autocomplete="address-level2" maxlength="100" /></label>
          <label>Название студии<input name="studio" autocomplete="organization" maxlength="120" /></label>
        </div>
        <div class="lf-row">
          <label>Email *<input name="email" type="email" required autocomplete="email" maxlength="120" placeholder="name@example.ru" /></label>
          <label>Телефон *<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="20" placeholder="+7 900 000-00-00" /></label>
        </div>
        <label>Комментарий<textarea name="message" rows="4" maxlength="2000" placeholder="Что снимаете? Что хотели бы упростить?"></textarea></label>
      </>
    ) : kind === 'call' ? (
      <>
        <div class="lf-row">
          <label>Имя *<input name="firstName" required autocomplete="given-name" maxlength="80" /></label>
          <label>Телефон *<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="20" placeholder="+7 900 000-00-00" /></label>
        </div>
        <label>Что обсудить<textarea name="message" rows="4" maxlength="2000" placeholder="Например, как перенести съёмки сезона в сервис"></textarea></label>
      </>
    ) : (
      <>
        <div class="lf-row">
          <label>Имя *<input name="firstName" required autocomplete="given-name" maxlength="80" /></label>
          <label>Email *<input name="email" type="email" required autocomplete="email" maxlength="120" placeholder="name@example.ru" /></label>
        </div>
        <label>Суть вопроса *<textarea name="question" required rows="5" maxlength="2000" placeholder="О возможностях, ролях, условиях подключения"></textarea></label>
      </>
    )}
    <label class="lf-check"><input name="consent" type="checkbox" required /><span>Даю согласие на <a href="/consent/" target="_blank">обработку персональных данных</a> и принимаю <a href="/privacy/" target="_blank">политику конфиденциальности</a> *</span></label>
    <p class="lf-error" role="alert" hidden></p>
    <div class="lf-submit">
      <button class="btn" type="submit">{btn}<Send size={17} /></button>
      <span class="lf-req">* Обязательные поля</span>
    </div>
  </form>
  <div class="lf-success" hidden tabindex="-1">
    <span class="lf-success-icon"><Check size={28} /></span>
    <h3>{kind === 'apply' ? 'Заявка принята.' : kind === 'call' ? 'Мы перезвоним.' : 'Вопрос принят.'}</h3>
    <p>{kind === 'apply' ? 'Команда ФотоКонтур рассмотрит заявку и свяжется с вами.' : kind === 'call' ? 'Свяжемся с вами по указанному номеру и разберём ваш процесс.' : 'Мы ответим на вопрос по указанной почте.'}</p>
    <button class="btn light" type="button" data-lf-reset>Заполнить заново</button>
  </div>
</div>

<style>
.lf-form{display:grid;gap:16px}
.lf-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.lf-row-3{grid-template-columns:1fr 1fr 1fr}
.lf label{display:grid;gap:7px;font-size:13px;font-weight:700;color:var(--ink)}
.lf input:not([type=checkbox]),.lf textarea{width:100%;font:inherit;font-weight:500;font-size:15px;padding:13px 14px;border:1px solid var(--line);border-radius:12px;background:var(--paper);color:var(--ink);transition:border-color .2s}
.lf textarea{resize:vertical;min-height:96px}
.lf input:focus,.lf textarea:focus{outline:none;border-color:var(--ink)}
.lf .is-bad{border-color:#5f5f5f;background:#f3f3f3}
.lf-check{display:flex !important;gap:10px;align-items:flex-start;font-weight:500 !important;font-size:13px !important;color:var(--muted) !important;line-height:1.5}
.lf-check input{width:18px;height:18px;margin-top:1px;accent-color:#141414;flex:none}
.lf-check a{color:var(--ink);text-decoration:underline;text-underline-offset:2px}
.lf-error{font-size:14px;font-weight:600;color:var(--ink)}
.lf-submit{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:4px}
.lf-req{font-size:13px;color:var(--muted)}
.lf-success{display:grid;gap:12px;justify-items:start;padding:12px 0}
.lf-success:focus{outline:none}
.lf-success-icon{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:var(--ink);color:var(--paper)}
.lf-success h3{font-size:24px;letter-spacing:-.02em}
.lf-success p{color:var(--muted)}
@media(max-width:640px){.lf-row,.lf-row-3{grid-template-columns:1fr}}
</style>

<script>
  const phoneOk = (v: string) => v.replace(/\D/g, '').length >= 10;
  const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  document.querySelectorAll<HTMLElement>('[data-lead-form]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const err = root.querySelector<HTMLElement>('.lf-error')!;
    const ok = root.querySelector<HTMLElement>('.lf-success')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const bad: string[] = [];
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input,textarea').forEach((f) => {
        let invalid = false;
        if (f instanceof HTMLInputElement && f.type === 'checkbox') invalid = f.required && !f.checked;
        else {
          const v = f.value.trim();
          invalid = (f.required && !v) || (!!v && f.type === 'email' && !emailOk(v)) || (!!v && f.type === 'tel' && !phoneOk(v));
          f.classList.toggle('is-bad', invalid);
        }
        if (invalid) bad.push(f.name);
      });
      if (bad.length) {
        err.textContent = bad.includes('consent') && bad.length === 1 ? 'Подтвердите согласие на обработку персональных данных.' : 'Проверьте обязательные поля: email и телефон должны быть указаны полностью.';
        err.hidden = false;
        form.querySelector<HTMLElement>('.is-bad, input[type=checkbox]:not(:checked)')?.focus();
        return;
      }
      err.hidden = true; form.hidden = true; ok.hidden = false; ok.focus();
    });
    form.addEventListener('input', (e) => (e.target as HTMLElement).classList.remove('is-bad'));
    root.querySelector('[data-lf-reset]')!.addEventListener('click', () => { form.reset(); ok.hidden = true; form.hidden = false; });
  });
</script>
