---
// «Родителю легко заказать; учреждению удобно»: один наглядный экран и короткие преимущества.
import { Eye, Ruler, CreditCard, Link2 } from '@lucide/astro';
const parent = [
  { icon: Eye, t: 'Видит снимки до покупки', p: 'Родитель покупает только то, что посмотрел сам. Претензий к воспитателям становится меньше.' },
  { icon: Ruler, t: 'Сам выбирает фото и размеры', p: 'Отмечает кадры и формат печати в своём кабинете — без бланков и пробников.' },
  { icon: CreditCard, t: 'Оплачивает онлайн', p: 'Картой или через СБП. Собирать деньги в группе не нужно.' },
];
---
<section class="parent-journey section" aria-labelledby="parent-journey-title">
  <div class="wrap pj-layout">
    <div class="pj-copy">
      <span class="eyebrow">Родителям и учреждению</span>
      <h2 id="parent-journey-title">Родителю легко заказать.<br/><span>Учреждению — удобно.</span></h2>
      <ul class="pj-list">
        {parent.map((x) => (
          <li><span class="pj-icon"><x.icon size={22}/></span><div><strong>{x.t}</strong><p>{x.p}</p></div></li>
        ))}
      </ul>
      <div class="pj-inst">
        <span class="pj-icon pj-icon--dark"><Link2 size={22}/></span>
        <div>
          <strong>Методист видит заказы своей группы</strong>
          <p>По защищённой ссылке, в реальном времени: кто уже заказал и кто ещё нет, суммы заказов и итоговый отчёт для учреждения.</p>
        </div>
      </div>
    </div>
    <figure class="pj-visual">
      <div class="pj-bar"><span></span><span></span><span></span><b>Кабинет родителя · ФотоКонтур</b></div>
      <img src="/media/parent-selection.jpg" alt="Экран выбора фотографий и формата печати в кабинете родителя" width="1440" height="1000" loading="lazy" decoding="async"/>
      {/* <figcaption>Выбор фотографий и формата печати в кабинете родителя.</figcaption> */}
    </figure>
  </div>
</section>

<style>
.pj-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:48px;align-items:center}
.pj-copy h2{font-size:clamp(28px,2.92vw,44px)}
.pj-copy h2 span{color:#5c5c5c}
.pj-list{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:18px}
.pj-list li,.pj-inst{display:flex;gap:16px;align-items:flex-start}
.pj-icon{flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:var(--paper);border:1px solid var(--line);color:var(--ink)}
.pj-icon--dark{background:var(--ink);border-color:var(--ink);color:#fff}
.pj-copy strong{display:block;font-size:17px;letter-spacing:-.01em;margin-bottom:4px}
.pj-copy p{font-size:15px;line-height:1.55;color:var(--muted)}
.pj-inst{margin-top:26px;padding:20px;border-radius:18px;background:var(--paper);border:1px solid var(--line)}
.pj-visual{margin:0;border-radius:20px;overflow:hidden;background:var(--paper);border:1px solid var(--line)}
.pj-bar{display:flex;align-items:center;gap:6px;padding:12px 16px;border-bottom:1px solid var(--line);font-size:12px}
.pj-bar span{width:9px;height:9px;border-radius:50%;background:#cfcfcf}
.pj-bar b{margin-left:8px;font-weight:700;color:var(--muted)}
.pj-visual img{display:block;width:100%;height:auto}
.pj-visual figcaption{padding:12px 16px;font-size:13px;color:var(--muted);border-top:1px solid var(--line)}
@media(max-width:960px){.pj-layout{grid-template-columns:1fr;gap:32px}}
</style>
