---
import { ArrowUpRight, Check, Images, MousePointer2, CreditCard } from '@lucide/astro';

const steps = [
  {
    number: '01',
    title: 'Открывает доступный альбом',
    detail: 'Родитель видит альбомы, доступные к покупке, в своём кабинете.',
    src: '/media/parent-albums.png',
    alt: 'Кабинет родителя со списком альбомов и вкладкой «Доступны к покупке»',
    caption: 'Доступные к покупке альбомы',
  },
  {
    number: '02',
    title: 'Выбирает фотографии',
    detail: 'Отмечает понравившиеся кадры и выбирает формат печати.',
    src: '/media/parent-selection.jpg',
    alt: 'Экран выбора фотографий и формата печати в кабинете родителя',
    caption: 'Фотографии и форматы печати',
  },
  {
    number: '03',
    title: 'Оформляет и оплачивает',
    detail: 'Проверяет корзину, оформляет заказ и оплачивает его в ФотоКонтур.',
    src: '/media/parent-cart.jpg',
    alt: 'Корзина родителя с составом заказа и кнопкой оплаты',
    caption: 'Корзина и оплата в сервисе',
  },
];
---

<section class="parent-journey section" aria-labelledby="parent-journey-title" data-parent-journey>
  <div class="wrap parent-journey-inner">
    <div class="parent-journey-copy">
      <span class="eyebrow">Дать клиенту выбрать</span>
      <h2 id="parent-journey-title">Родителю просто купить.<br/><span>Вам — видеть заказ.</span></h2>
      <p class="lead">Весь путь покупки проходит в кабинете ФотоКонтур: от доступного альбома до оплаты. Родителю не нужно объяснять каждый шаг в переписке.</p>

      <div class="parent-steps" aria-label="Путь родителя">
        {steps.map((step, index) => (
          <button class="parent-step" type="button" data-parent-step={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="parent-journey-screen">
            <span class="parent-step-text"><strong>{step.title}</strong><small>{step.detail}</small></span>
            <span class="parent-step-mark" aria-hidden="true"><Check size={16}/></span>
          </button>
        ))}
      </div>

    </div>

    <div class="parent-journey-visual" id="parent-journey-screen" aria-live="polite">
      <div class="parent-screen-heading"><span class="parent-screen-icon"><Images size={17}/></span><span data-parent-screen-label>Альбомы</span><span class="parent-screen-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
      <div class="parent-screen-frame">
        <div class="parent-screen-toolbar"><span></span><span></span><span></span><b>Кабинет родителя · ФотоКонтур</b></div>
        <a data-parent-screen-link href={steps[0].src} target="_blank" rel="noopener" aria-label="Открыть снимок экрана крупно"><img data-parent-screen-image src={steps[0].src} alt={steps[0].alt} width="1440" height="1000" loading="lazy" decoding="async"/></a>
        <div class="parent-screen-caption"><span data-parent-screen-caption>{steps[0].caption}</span></div>
      </div>
      <div class="parent-screen-progress" aria-hidden="true"><span data-parent-progress></span></div>
    </div>
  </div>
</section>

<script define:vars={{ steps }}>
  document.querySelectorAll('[data-parent-journey]').forEach((section) => {
    const buttons = [...section.querySelectorAll('[data-parent-step]')];
    const image = section.querySelector('[data-parent-screen-image]');
    const link = section.querySelector('[data-parent-screen-link]');
    const captionLink = section.querySelector('[data-parent-screen-caption-link]');
    const caption = section.querySelector('[data-parent-screen-caption]');
    const label = section.querySelector('[data-parent-screen-label]');
    const progress = section.querySelector('[data-parent-progress]');
    const labels = ['Альбомы', 'Фотографии', 'Заказ'];
    function selectStep(index) {
      const step = steps[index];
      buttons.forEach((button, buttonIndex) => button.setAttribute('aria-pressed', String(buttonIndex === index)));
      image.src = step.src;
      image.alt = step.alt;
      link.href = step.src;
      if (captionLink) captionLink.href = step.src;
      caption.textContent = step.caption;
      label.textContent = labels[index];
      progress.style.width = `${((index + 1) / steps.length) * 100}%`;
    }
    buttons.forEach((button, index) => button.addEventListener('click', () => selectStep(index)));
  });
</script>

<style>
  .parent-journey{background:#f1f1f1;border-block:1px solid #e6e6e6;overflow:hidden}
  .parent-journey-inner{display:grid;grid-template-columns:minmax(0,.93fr) minmax(0,1.07fr);align-items:center;gap:clamp(46px,6vw,100px)}
  .parent-journey-copy h2{font-size:clamp(29px,2.92vw,44px);max-width:650px;letter-spacing:-.055em}
  .parent-journey-copy h2 span{color:#6d6d6d}
  .parent-journey-copy .lead{font-size:17px;line-height:1.65;margin-top:25px;max-width:590px}
  .parent-steps{margin-top:34px;border-top:1px solid #dadada}
  .parent-step{display:grid;grid-template-columns:minmax(0,1fr) 26px;align-items:start;gap:16px;width:100%;padding:20px 8px;border:0;border-bottom:1px solid #dadada;background:transparent;text-align:left;transition:background .25s,padding-left .25s}
  .parent-step:hover,.parent-step[aria-pressed="true"]{background:#ffffffa8;padding-left:15px}
  .parent-step-index{color:#6d6d6d;font-size:13px;font-weight:800;line-height:1.8}
  .parent-step-text{display:grid;gap:6px}.parent-step-text strong{font-size:18px;line-height:1.3;font-weight:700}.parent-step-text small{font-size:13px;line-height:1.55;color:#616161;max-width:420px}
  .parent-step-mark{width:24px;height:24px;border:1px solid #bfbfbf;border-radius:50%;display:grid;place-items:center;color:transparent;transition:background .25s,color .25s}
  .parent-step[aria-pressed="true"] .parent-step-mark{background:#6d6d6d;border-color:#6d6d6d;color:white}
  .parent-journey-footer{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:24px}.parent-journey-footer .text-link{font-size:13px}.parent-demo-note{font-size:12px;color:#7a7a7a}
  .parent-journey-visual{min-width:0}
  .parent-screen-heading{display:flex;gap:10px;align-items:center;font-size:12px;font-weight:750;letter-spacing:.04em;margin-bottom:16px;color:#404040}
  .parent-screen-icon{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:#e4e4e4;color:#6d6d6d}
  .parent-screen-dots{display:flex;gap:5px;margin-left:auto}.parent-screen-dots i{width:5px;height:5px;border-radius:50%;background:#c2c2c2}
  .parent-screen-frame{background:white;border:1px solid #d4d4d4;border-radius:17px;overflow:hidden;box-shadow:0 20px 50px #4343431a;max-width:620px;margin-inline:auto}
  .parent-screen-toolbar{display:flex;align-items:center;gap:5px;padding:11px 14px;border-bottom:1px solid #e8e8e8}.parent-screen-toolbar span{width:5px;height:5px;border-radius:50%;background:#c4c4c4}.parent-screen-toolbar b{margin-left:auto;font-size:10px;font-weight:500;color:#868686}
  .parent-screen-frame>a{display:block}.parent-screen-frame img{display:block;width:100%;height:auto;aspect-ratio:1.44;object-fit:contain}
  .parent-screen-caption{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;font-size:11px;color:#777777}.parent-screen-caption a{font-weight:750;color:#616161;white-space:nowrap}.parent-screen-caption a:hover{text-decoration:underline}
  .parent-screen-progress{height:3px;background:#e0e0e0;margin-top:19px;border-radius:99px;overflow:hidden}.parent-screen-progress span{display:block;height:100%;width:33.333%;background:#6d6d6d;transition:width .3s}
  .parent-screen-benefit{display:flex;justify-content:center;align-items:center;gap:10px;margin-top:17px;color:#545454;font-size:12px;font-weight:700}.parent-screen-benefit svg{color:#6d6d6d}.parent-screen-benefit i{width:1px;height:18px;background:#cbcbcb;margin-inline:5px}
  @media(max-width:950px){.parent-journey-inner{grid-template-columns:1fr;gap:35px}.parent-journey-copy h2{max-width:750px}.parent-screen-frame{max-width:720px}.parent-journey-visual{max-width:760px;width:100%;margin:auto}}
  @media(max-width:620px){.parent-journey-copy h2{font-size:clamp(28px,6.46vw,33px)}.parent-journey-copy .lead{font-size:15px;margin-top:20px}.parent-steps{margin-top:25px}.parent-step{grid-template-columns:minmax(0,1fr) 22px;gap:9px;padding:15px 4px}.parent-step:hover,.parent-step[aria-pressed="true"]{padding-left:8px}.parent-step-text strong{font-size:15px}.parent-step-text small{font-size:12px}.parent-journey-footer{gap:8px;display:block}.parent-demo-note{display:block;margin-top:7px}.parent-screen-heading{margin-bottom:10px}.parent-screen-caption{font-size:10px}.parent-screen-benefit{font-size:10px;gap:6px}.parent-screen-benefit i{margin-inline:2px}}
  @media(prefers-reduced-motion:reduce){.parent-step,.parent-step-mark,.parent-screen-progress span{transition:none}}
</style>
