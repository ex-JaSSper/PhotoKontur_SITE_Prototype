---
import {Play,RotateCcw,Maximize,ArrowUpRight} from '@lucide/astro';
const screens=[['photosessions','Фотосессии'],['photosession','Карточка съёмки'],['albums','Альбомы'],['album','Альбом и клиентский выбор'],['themes','Тематики'],['templates','Шаблоны'],['orders','Заказы'],['dashboard','Дашборды'],['institutions','Учреждения'],['clients','Клиенты'],['staff','Команда'],['report-albums','Отчёт по альбомам'],['report-institution','Отчёт по учреждениям'],['finance','Финансы'],['finance-history','История операций'],['feed','Уведомления']];
---
<div class="live-demo" id="demo"><div class="demo-bar"><div><span class="eyebrow">Интерактивный кабинет</span><p>Руководитель студии + предпросмотр клиента</p></div><button class="btn" id="demo-tour"><Play size={18}/>Экскурсия по сервису</button></div><div class="demo-controls"><label>Открыть раздел<select id="demo-screen">{screens.map(([v,t])=><option value={v}>{t}</option>)}</select></label><button id="demo-reset"><RotateCcw size={17}/>Сбросить демо</button><button id="demo-expand" aria-pressed="false"><Maximize size={17}/>Развернуть</button><button id="demo-exit" hidden>Выйти из экскурсии</button></div><p class="demo-state" id="demo-status" role="status">Нажимайте на разделы и элементы кабинета или включите экскурсию с подсказками.</p><iframe id="service-demo" title="Кликабельный демонстрационный кабинет ФотоКонтур" src="/demo/app/photosessions.html" sandbox="allow-scripts" loading="lazy"></iframe><div class="demo-complete" id="demo-complete" hidden tabindex="-1"><h3>Вы прошли путь от съёмки до заказа.</h3><p>Продолжите исследовать кабинет или расскажите о задачах вашей студии.</p><a class="btn" href="#apply">Заявка на модерацию<ArrowUpRight size={18}/></a><button class="text-link" id="demo-again">Повторить экскурсию</button></div></div><p class="demo-disclaimer">Все имена, изображения и суммы вымышлены. Изменения действуют только на текущем экране и сбрасываются при переходе. Загрузка, рассылки, оплата и серверное сохранение не выполняются. Условные кадры заменяют детские фотографии.</p><noscript><p class="notice">Включите JavaScript для управления демо и экскурсии.</p></noscript>
<script>
const frame=document.querySelector<HTMLIFrameElement>('#service-demo')!;
const host=document.querySelector<HTMLElement>('#demo')!;
const status=document.querySelector<HTMLElement>('#demo-status')!;
const select=document.querySelector<HTMLSelectElement>('#demo-screen')!;
const exit=document.querySelector<HTMLButtonElement>('#demo-exit')!;
const complete=document.querySelector<HTMLElement>('#demo-complete')!;
const allowed=new Set(Array.from(select.options,o=>o.value).concat(['institution','template']));
function navigate(screen:string,tour=false){if(!allowed.has(screen))return;frame.src=`/demo/app/${screen}.html${tour?'?tour=0':''}`;complete.hidden=true;exit.hidden=!tour;status.textContent=tour?'Запускаем экскурсию…':'Самостоятельное исследование · изменения не сохраняются.';}
function start(){navigate('photosessions',true);host.scrollIntoView({behavior:'instant',block:'start'});frame.focus();}
const requestedScreen=new URLSearchParams(window.location.search).get('screen');
if(requestedScreen&&Array.from(select.options).some(option=>option.value===requestedScreen)){select.value=requestedScreen;navigate(requestedScreen);}
document.querySelector('#demo-tour')!.addEventListener('click',start);
document.querySelector('#demo-again')!.addEventListener('click',start);
select.addEventListener('change',()=>navigate(select.value));
document.querySelector('#demo-reset')!.addEventListener('click',()=>{select.value='photosessions';navigate('photosessions')});
document.querySelector('#demo-expand')!.addEventListener('click',e=>{const expanded=host.classList.toggle('expanded');(e.currentTarget as HTMLElement).setAttribute('aria-pressed',String(expanded));document.body.classList.toggle('demo-expanded',expanded)});
exit.addEventListener('click',()=>frame.contentWindow?.postMessage({channel:'fk-demo',type:'exit'},'*'));
window.addEventListener('message',e=>{if(e.source!==frame.contentWindow||e.origin!=='null')return;const m=e.data;if(!m||m.channel!=='fk-demo'||!['ready','step','closed','complete'].includes(m.type)||!allowed.has(m.screen))return;if(Array.from(select.options).some(o=>o.value===m.screen))select.value=m.screen;if(m.type==='step'&&Number.isInteger(m.step)&&m.step>=0&&m.step<8){exit.hidden=false;status.textContent=`Экскурсия · шаг ${m.step+1} из 8. Нажмите выделенный элемент или «Далее».`;}if(m.type==='closed'||m.type==='complete'){exit.hidden=true;status.textContent='Экскурсия завершена. Кабинет доступен для самостоятельного исследования.';complete.hidden=m.type!=='complete';if(m.type==='complete')complete.focus();else document.querySelector<HTMLButtonElement>('#demo-tour')?.focus()}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&host.classList.contains('expanded')){host.classList.remove('expanded');document.body.classList.remove('demo-expanded');document.querySelector('#demo-expand')!.setAttribute('aria-pressed','false')}});
</script>
<style>.live-demo{border:1px solid #cbcbcb;border-radius:24px;background:white;overflow:hidden;scroll-margin-top:96px}.demo-bar{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:26px}.demo-bar .eyebrow{margin-bottom:7px}.demo-bar p{font-size:12px;color:var(--muted)}.demo-controls{display:flex;align-items:end;flex-wrap:wrap;gap:18px;padding:18px 26px;background:#f2f2f2;border-block:1px solid #e1e1e1}.demo-controls label{display:grid;gap:6px;font-size:10px;font-weight:700}.demo-controls select{border:1px solid #c8c8c8;border-radius:8px;padding:11px;background:white;font-size:13px;max-width:100%}.demo-controls button{display:flex;align-items:center;gap:8px;background:transparent;border:0;padding:11px 0;min-height:44px;font-size:12px;font-weight:700}.demo-state{padding:12px 26px;font-size:11px;color:#5d5d5d;max-width:none}iframe{display:block;width:100%;height:790px;border:0;border-top:1px solid #e1e1e1;background:#f6f6f6}.demo-disclaimer{font-size:11px;color:var(--muted);max-width:100ch;margin-top:18px;line-height:1.8}.demo-complete{padding:32px;background:#e9e9e9}.demo-complete p{margin-block:18px}.demo-complete button{border:0;background:transparent;margin-left:20px}.live-demo.expanded{position:fixed;inset:10px;z-index:5000;border-radius:16px;overflow:auto;display:flex;flex-direction:column;scroll-margin:0}.expanded iframe{flex:1;min-height:400px}.expanded .demo-bar{padding:14px 24px}.expanded .demo-controls{padding-block:10px}:global(body.demo-expanded){overflow:hidden}@media(max-width:760px){.live-demo{border-radius:15px}.demo-bar{padding:20px;align-items:stretch;flex-direction:column;gap:18px}.demo-controls{padding:15px;gap:6px 18px}.demo-controls label{width:100%}.demo-controls select{width:100%}.demo-state{padding:12px 16px;font-size:10px}iframe{height:750px}.demo-complete{padding:24px}.demo-complete button{margin:15px 0 0}.live-demo.expanded{inset:0;border-radius:0}.expanded .demo-bar>div{display:none}.expanded .demo-bar{padding:8px 15px}.expanded .demo-bar .btn{min-height:42px;padding:10px}.expanded iframe{min-height:320px}.expanded .demo-controls{gap:2px 15px;padding:8px 15px}.expanded .demo-controls label{display:none}}</style>
