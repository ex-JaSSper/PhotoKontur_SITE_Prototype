---
// Отзывы: главный кейс крупно + карточки историй, каждая открывается в окне (нативный <dialog>).
import { ArrowUpRight, Quote, X } from '@lucide/astro';
import { reviews } from '../content/reviews';
const featured = reviews.find((r) => r.featured) ?? reviews[0];
const rest = reviews.filter((r) => r !== featured);
---
<div class="rv" data-reviews>
  <article class="rv-hero" aria-labelledby="rv-hero-title">
    <div class="ph rv-hero-media" role="img" aria-label="Место для фото студии"><span>Фото студии · {featured.studio}</span></div>
    <div class="rv-hero-body">
      <div class="rv-hero-top">
        <span class="rv-flag">Главная история</span>
        <span class="rv-sample">Пример оформления</span>
      </div>
      <div class="rv-id">
        <span class="rv-logo"><svg viewBox="0 0 48 48" width="28" height="28" aria-hidden="true" set:html={featured.logo} /></span>
        <span><strong>{featured.studio}</strong><small>{featured.meta}</small></span>
      </div>
      <h2 id="rv-hero-title">{featured.title}</h2>
      <blockquote class="rv-hero-quote">«{featured.quote}»</blockquote>
      <p class="rv-who"><b>{featured.name}</b>{featured.role}, {featured.studio}</p>
      <dl class="rv-facts">
        <div><dt>Задача</dt><dd>{featured.task}</dd></div>
        <div><dt>Что изменилось</dt><dd>{featured.result}</dd></div>
      </dl>
      <button type="button" class="btn rv-open-hero" data-open={featured.slug}>Читать историю<ArrowUpRight size={18}/></button>
    </div>
  </article>

  <div class="rv-grid-head">
    <h2>Ещё истории студий</h2>
    <p>Нажмите на карточку, чтобы прочитать историю целиком.</p>
  </div>
  <ul class="rv-grid">
    {rest.map((r) => (
      <li>
        <button type="button" class="rv-card" data-open={r.slug} aria-haspopup="dialog">
          <span class="rv-id">
            <span class="rv-logo"><svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true" set:html={r.logo} /></span>
            <span><strong>{r.studio}</strong><small>{r.meta}</small></span>
          </span>
          <span class="rv-card-title">{r.title}</span>
          <span class="rv-card-quote"><Quote size={18} aria-hidden="true"/>{r.quote}</span>
          <span class="rv-who"><b>{r.name}</b>{r.role}</span>
          <span class="rv-card-more">Открыть историю<ArrowUpRight size={16}/></span>
        </button>
      </li>
    ))}
  </ul>
  <p class="rv-note">Так будут выглядеть отзывы студий. Названия, люди и цитаты здесь вымышлены, вместо фото — заглушки; реальные отзывы появятся только с согласия авторов.</p>

  {reviews.map((r) => (
    <dialog class="rv-dialog" id={`story-${r.slug}`} aria-labelledby={`story-${r.slug}-title`} data-dialog={r.slug}>
      <div class="rv-dialog-inner">
        <header class="rv-dialog-head">
          <span class="rv-id">
            <span class="rv-logo"><svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true" set:html={r.logo} /></span>
            <span><strong>{r.studio}</strong><small>{r.meta}</small></span>
          </span>
          <form method="dialog"><button class="rv-close" aria-label="Закрыть историю"><X size={20}/></button></form>
        </header>
        <div class="ph rv-dialog-media" role="img" aria-label="Место для фото студии"><span>Фото студии · {r.studio}</span></div>
        <h2 id={`story-${r.slug}-title`}>{r.title}</h2>
        <div class="rv-dialog-grid">
          <section><h3>Задача</h3><p>{r.task}</p></section>
          <section><h3>Что сделали в ФотоКонтур</h3><ul>{r.solution.map((s) => <li>{s}</li>)}</ul></section>
          <section><h3>Что изменилось</h3><p>{r.result}</p></section>
        </div>
        <figure class="rv-dialog-quote">
          <Quote size={24} aria-hidden="true"/>
          <blockquote>{r.story.map((p) => <p>{p}</p>)}</blockquote>
          <figcaption><b>{r.name}</b>{r.role}, «{r.studio}»</figcaption>
        </figure>
        <footer class="rv-dialog-foot">
          <span>Пример оформления · студия вымышлена</span>
          {/* <a class="btn" href="#apply">Обсудить подключение<ArrowUpRight size={18}/></a> */}
        </footer>
      </div>
    </dialog>
  ))}
</div>

<style>
.rv-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);border-radius:28px;overflow:hidden;background:var(--paper);border:1px solid var(--line)}
.rv-hero-media{min-height:420px;border-radius:0}
.rv-hero-body{padding:36px 40px;display:flex;flex-direction:column;gap:18px}
.rv-hero-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.rv-flag{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--paper);background:var(--ink);padding:7px 12px;border-radius:999px}
.rv-sample{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);padding:6px 12px;border-radius:999px}
.rv-id{display:flex;align-items:center;gap:12px;text-align:left}
.rv-id strong{display:block;font-size:17px;letter-spacing:-.01em}
.rv-id small{display:block;font-size:13px;color:var(--muted);margin-top:2px}
.rv-logo{flex:none;display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--bg);color:var(--ink)}
.rv-hero h2{font-size:clamp(26px,2.2vw,32px);line-height:1.08;letter-spacing:-.035em}
.rv-hero-quote{margin:0;font-size:clamp(21px,1.8vw,26px);line-height:1.35;letter-spacing:-.02em;padding-left:20px;border-left:3px solid var(--ink)}
.rv-who{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline;font-size:15px;color:var(--muted)}
.rv-who b{font-size:17px;color:var(--ink)}
.rv-facts{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:6px 0 0;padding-top:20px;border-top:1px solid var(--line)}
.rv-facts dt{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.rv-facts dd{margin:0;font-size:15px;line-height:1.5}
.rv-open-hero{align-self:flex-start;margin-top:auto}

.rv-grid-head{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin:48px 0 20px}
.rv-grid-head h2{font-size:28px;letter-spacing:-.03em}
.rv-grid-head p{color:var(--muted)}
.rv-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.rv-card{width:100%;height:100%;display:flex;flex-direction:column;gap:18px;text-align:left;padding:28px;background:var(--paper);border:1px solid var(--line);border-radius:22px;cursor:pointer;font:inherit;color:inherit;transition:border-color .2s,transform .2s,box-shadow .2s}
.rv-card:hover{border-color:var(--ink);transform:translateY(-3px);box-shadow:0 18px 40px -28px rgba(20,20,20,.5)}
.rv-card:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.rv-card-title{font-size:22px;font-weight:700;line-height:1.2;letter-spacing:-.025em}
.rv-card-quote{display:flex;gap:10px;font-size:17px;line-height:1.5;color:var(--ink)}
.rv-card-quote svg{flex:none;margin-top:3px;color:var(--muted)}
.rv-card .rv-who{margin-top:auto}
.rv-card-more{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:800;padding-top:16px;border-top:1px solid var(--line)}
.rv-card:hover .rv-card-more{text-decoration:underline;text-underline-offset:4px}
.rv-note{margin-top:20px;font-size:13px;color:var(--muted);max-width:760px}

/* Окно истории */
.rv-dialog{width:min(900px,calc(100% - 32px));max-height:calc(100dvh - 48px);padding:0;border:0;border-radius:26px;background:var(--paper);color:var(--ink);overflow:auto;overscroll-behavior:contain}
.rv-dialog::backdrop{background:rgba(20,20,20,.62);backdrop-filter:blur(3px)}
.rv-dialog[open]{animation:rv-in .28s cubic-bezier(.2,.8,.2,1)}
@keyframes rv-in{from{opacity:0;transform:translateY(16px) scale(.98)}}
.rv-dialog-inner{padding:28px 36px 32px;display:grid;gap:26px}
.rv-dialog-head{display:flex;justify-content:space-between;align-items:center;gap:16px;position:sticky;top:-28px;background:var(--paper);padding:28px 0 14px;margin-top:-28px;z-index:2;border-bottom:1px solid var(--line)}
.rv-close{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--paper);cursor:pointer;color:var(--ink)}
.rv-close:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.rv-dialog-media{aspect-ratio:21/8;border-radius:18px;min-height:0}
.rv-dialog h2{font-size:clamp(26px,2.04vw,28px);line-height:1.1;letter-spacing:-.03em}
.rv-dialog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.rv-dialog-grid h3{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.rv-dialog-grid p,.rv-dialog-grid li{font-size:15px;line-height:1.55}
.rv-dialog-grid ul{margin:0;padding-left:18px;display:grid;gap:8px}
.rv-dialog-quote{margin:0;padding:26px 28px;border-radius:20px;background:var(--bg);display:grid;gap:14px}
.rv-dialog-quote svg{color:var(--muted)}
.rv-dialog-quote blockquote{margin:0;display:grid;gap:12px;font-size:19px;line-height:1.5;letter-spacing:-.01em}
.rv-dialog-quote figcaption{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline;color:var(--muted);font-size:15px}
.rv-dialog-quote figcaption b{color:var(--ink);font-size:17px}
.rv-dialog-foot{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding-top:20px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}

@media(max-width:960px){
  .rv-hero{grid-template-columns:1fr}
  .rv-hero-media{min-height:260px}
  .rv-hero-body{padding:28px 24px}
  .rv-dialog-grid{grid-template-columns:1fr}
}
@media(max-width:700px){
  .rv-grid{grid-template-columns:1fr}
  .rv-facts{grid-template-columns:1fr}
  .rv-card{padding:22px}
  /* На телефоне окно выезжает снизу на всю ширину */
  .rv-dialog{width:100%;max-width:100%;max-height:92dvh;margin:auto 0 0;border-radius:24px 24px 0 0}
  .rv-dialog[open]{animation:rv-up .3s cubic-bezier(.2,.8,.2,1)}
  @keyframes rv-up{from{transform:translateY(40px);opacity:.6}}
  .rv-dialog-inner{padding:20px 20px calc(24px + env(safe-area-inset-bottom))}
  .rv-dialog-head{top:-20px;margin-top:-20px;padding-top:20px}
  .rv-dialog-media{aspect-ratio:16/9}
}
@media(prefers-reduced-motion:reduce){.rv-dialog[open]{animation:none}.rv-card{transition:none}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const dialogs = new Map([...root.querySelectorAll<HTMLDialogElement>('[data-dialog]')].map((d) => [d.dataset.dialog!, d]));
    let opener: HTMLElement | null = null;
    const open = (slug: string, from?: HTMLElement | null, push = true) => {
      const d = dialogs.get(slug); if (!d || d.open) return;
      opener = from ?? null;
      d.showModal();
      d.scrollTop = 0;
      document.documentElement.style.overflow = 'hidden';
      // своя ссылка на историю; «Назад» закрывает окно
      if (push) history.pushState({ story: slug }, '', `#story-${slug}`);
    };
    root.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open!, b)));
    dialogs.forEach((d) => {
      d.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
        if (location.hash === `#${d.id}`) {
          if (history.state?.story) history.back();
          else history.replaceState(null, '', location.pathname + location.search);
        }
        opener?.focus();
      });
      // клик по затемнению закрывает окно
      d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    });
    window.addEventListener('popstate', () => {
      dialogs.forEach((d) => { if (d.open && location.hash !== `#${d.id}`) d.close(); });
      const m = location.hash.match(/^#story-(.+)$/);
      if (m) open(m[1], null, false);
    });
    // прямая ссылка /reviews/#story-…
    const m = location.hash.match(/^#story-(.+)$/);
    if (m) open(m[1], null, false);
  });
</script>
