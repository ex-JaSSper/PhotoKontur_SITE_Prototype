---
// «Знакомые проблемы фотографа»: рутина, от которой освобождает сервис. Иконка, заголовок, короткий текст.
import { Images, ClipboardList, Users, BellRing, ScanFace, Calculator } from '@lucide/astro';

const items = [
  { icon: Images, title: 'Без печати пробников', text: 'Не нужно печатать пробники на каждого ребёнка и ждать, пока их вернут. Родители смотрят снимки онлайн и выбирают сами.' },
  { icon: ClipboardList, title: 'Без бланков и списков', text: 'Родители сами оформляют заказ: фотографии, размеры, количество. Вы получаете готовый состав заказа, переписывать ничего не нужно.' },
  { icon: Users, title: 'Без уточнений с методистом', text: 'Методист по ссылке видит, кто в группе уже заказал, а кто ещё нет. Созваниваться и сверять списки не придётся.' },
  { icon: BellRing, title: 'Без напоминаний вручную', text: 'Не нужно по несколько раз писать в родительские чаты. О готовых фотографиях и заказах родители узнают из уведомлений.' },
  { icon: ScanFace, title: 'Без ручной сортировки', text: 'Кадры раскладываются по альбомам детей автоматически. Искать каждого ребёнка среди сотен снимков больше не нужно.' },
  { icon: Calculator, title: 'Без подсчётов в тетради', text: 'Суммы по группам, оплаты и отчёт для учреждения собираются сами. Видно, сколько принесла каждая съёмка.' },
];
---
<section class="feature-explorer" aria-labelledby="feature-title">
  <div class="wrap">
    <div class="feature-intro">
      <span class="eyebrow">Знакомо по каждой съёмке</span>
      <h2 id="feature-title">Рутина после съёмки —<br/><em>больше не на вас.</em></h2>
    </div>
    <ul class="feature-grid">
      {items.map((it) => (
        <li class="feature-card">
          <span class="feature-icon"><it.icon size={30} stroke-width={1.6}/></span>
          <div>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.feature-explorer{background:#eeeeee;padding-block:41px 37px}
.feature-intro{margin-bottom:31px}
.feature-intro h2{font-size:clamp(28px,2.89vw,41px)}
.feature-intro em{font-style:normal;color:#5c5c5c}
.feature-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.feature-card{display:flex;gap:20px;align-items:flex-start;padding:28px;background:var(--paper);border:1px solid var(--line);border-radius:18px}
.feature-icon{flex:none;display:grid;place-items:center;width:72px;height:72px;border-radius:50%;background:#f0f0f0;color:var(--ink)}
.feature-card h3{font-size:20px;letter-spacing:-.02em;margin-bottom:8px}
.feature-card p{font-size:15px;line-height:1.55;color:var(--muted)}
@media(max-width:1000px){.feature-grid{grid-template-columns:1fr}}
@media(max-width:760px){.feature-explorer{padding-block:33px}.feature-intro h2{font-size:clamp(28px,6.12vw,33px)}.feature-card{padding:20px;gap:16px}.feature-icon{width:56px;height:56px}}
</style>
