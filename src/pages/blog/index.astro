---
import Base from '../../layouts/BaseLayout.astro';
import Card from '../../components/ArticleCard.astro';
import { articles } from '../../content/articles';
---
<Base title="Блог о работе фотостудии">
  <section class="bh">
    <div class="wrap bh-inner">
      <div>
        <h1>За кадром<br/><em>хорошей работы.</em></h1>
        <p class="lead">Процессы, продукт и управление фотостудией. Практические разборы для тех, кто развивает своё дело в фотографии.</p>
      </div>
    </div>
  </section>

  <section class="wrap blog-section">
    <div class="blog-grid">
      {articles.map((a, i) => <Card article={a} featured={i === 0} />)}
    </div>
  </section>

</Base>

<style>
.bh{padding:43px 0 32px}
.bh-kicker{font-size:13px;font-weight:700;letter-spacing:.04em;color:var(--muted);margin-bottom:22px}
.bh-inner{display:grid;grid-template-columns:1fr;gap:48px;align-items:end}
.bh h1 em{font-style:normal;color:var(--steel)}
.bh .lead{margin-top:26px}

.blog-section{padding-bottom:32px}

.blog-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}
.blog-grid > *{animation:blog-in .5s ease both}
.blog-grid > *:nth-child(2){animation-delay:.08s}.blog-grid > *:nth-child(3){animation-delay:.16s}
@keyframes blog-in{from{opacity:0;transform:translateY(18px)}}


@media(max-width:760px){
  .bh{padding:32px 0 30px}
  .blog-grid{grid-template-columns:1fr;gap:16px}
}
@media(prefers-reduced-motion:reduce){.blog-grid > *{animation:none}}
</style>
