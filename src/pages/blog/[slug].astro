---
import Base from '../../layouts/BaseLayout.astro';
import Card from '../../components/ArticleCard.astro';
import { articles, toneOf, isPhotoCover, inline, type Img } from '../../content/articles';
export function getStaticPaths(){ return articles.map(article => ({ params: { slug: article.slug }, props: { article } })) }
const { article: a } = Astro.props;
const tone = toneOf(a.category);
const photo = isPhotoCover(a);
const related = articles.filter(x => x.slug !== a.slug);
const pad = (n: number) => String(n).padStart(2, '0');
// Сквозная нумерация иллюстраций внутри статьи: «Рис. 1», «Рис. 2»…
let fig = 0;
const nextFig = () => ++fig;
---
<Base title={a.title} description={a.excerpt}>
  <div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>
  <article class:list={['post', `tone-${tone}`]}>
    <header class="wrap post-head">
      <nav class="post-crumbs" aria-label="Навигация"><a href="/blog/">← Блог</a></nav>
      <h1>{a.title}</h1>
      <p class="post-lead">{a.excerpt}</p>
      <dl class="post-byline">
        <div><dt>Чтение</dt><dd>{a.reading}</dd></div>
        <div><dt>Подготовлено</dt><dd>{a.preparedAt}</dd></div>
        <div><dt>Автор</dt><dd>Редакция ФотоКонтур</dd></div>
      </dl>
    </header>

    <div class="wrap">
      <figure class:list={['post-cover', { 'post-cover-photo': photo }]}>
        {photo ? <div class="ph post-cover-ph" role="img" aria-label={a.alt}><span>Обложка статьи · фото</span></div> : <a href={a.cover} target="_blank" rel="noopener" aria-label="Открыть иллюстрацию целиком"><img src={a.cover} alt={a.alt} decoding="async" /></a>}
        {/* {!photo && <figcaption>Полный экран интерфейса · демонстрационные данные · нажмите, чтобы открыть целиком</figcaption>} */}
      </figure>
    </div>

    <div class="wrap post-layout">
      <aside class="post-toc" aria-label="Содержание">
        <span class="post-toc-title">Содержание</span>
        <ol>{a.sections.map((s, i) => <li><a href={`#part-${i + 1}`} data-toc={`part-${i + 1}`}>{s.title}</a></li>)}</ol>
        <button type="button" class="post-copy" data-copy-link>Скопировать ссылку</button>
      </aside>

      <div class="post-body">
        {a.sections.map((s, i) => (
          <section id={`part-${i + 1}`} class="post-part" data-part>
            <h2>{s.title}</h2>
            {s.blocks.map(b => {
              const frame = (img: Img, n: number) => img.kind === 'photo' ? (
                <div class="ph b-img b-img-ph" role="img" aria-label={img.alt}><span>Фото · {img.alt}</span></div>
              ) : (
                <a class:list={['b-img', `b-img-${img.kind}`]} href={img.src} target="_blank" rel="noopener" aria-label={`${img.alt} — открыть целиком`}>
                  <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                </a>
              );
              const caption = (img: Img, n: number) => img.caption && <figcaption><b>Рис. {n}</b>{img.caption}</figcaption>;
              if (b.t === 'p') return <p class="b-p" set:html={inline(b.text)} />;
              if (b.t === 'list') return <ul class="b-list">{b.items.map(it => <li set:html={inline(it)} />)}</ul>;
              if (b.t === 'steps') return <ol class="b-steps">{b.items.map(st => <li><strong>{st.title}</strong><span set:html={inline(st.text)} /></li>)}</ol>;
              if (b.t === 'quote') return <blockquote class="b-quote"><p>{b.text}</p>{b.by && <cite>{b.by}</cite>}</blockquote>;
              if (b.t === 'note') return <aside class="b-note"><strong>{b.title}</strong><p set:html={inline(b.text)} /></aside>;
              if (b.t === 'figure') { const n = nextFig(); return <figure class:list={['b-figure', { 'b-wide': b.wide }]}>{frame(b.img, n)}{caption(b.img, n)}</figure>; }
              if (b.t === 'media') { const n = nextFig(); return (
                <div class:list={['b-media', `b-media-${b.side}`]}>
                  <figure>{frame(b.img, n)}{caption(b.img, n)}</figure>
                  <div class="b-media-text">{b.text.map(t => <p set:html={inline(t)} />)}</div>
                </div>
              ); }
              if (b.t === 'pair') return <div class="b-pair">{b.imgs.map(img => { const n = nextFig(); return <figure>{frame(img, n)}{caption(img, n)}</figure>; })}</div>;
              if (b.t === 'compare') return (
                <div class="b-compare"><p class="b-compare-title">{b.title}</p><div>{b.cols.map((c, ci) => <section><span>{ci === 0 ? 'А' : 'Б'}</span><strong>{c.head}</strong><p>{c.text}</p></section>)}</div></div>
              );
              if (b.t === 'links') return (
                <nav class="b-links" aria-label={b.title}><p class="b-links-title">{b.title}</p>{b.items.map(l => <a class="b-link" href={l.href}><span class="b-links-meta">{l.meta}</span><span class="b-links-label">{l.label}</span><span class="b-links-arrow" aria-hidden="true">→</span></a>)}</nav>
              );
              return null;
            })}
          </section>
        ))}

        <aside class="post-end">
          <p>Посмотрите, как это устроено в кабинете: кликабельный прототип ФотоКонтур с инструкцией по сервису.</p>
          <a class="post-end-link" href="/how-it-works/">Открыть демо <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </div>
  </article>

  <section class="section wrap post-more">
    <div class="post-more-head"><h2>Ещё в блоге.</h2><a class="text-link" href="/blog/">Все материалы →</a></div>
    <div class="related">{related.map(article => <Card article={article} />)}</div>
  </section>
</Base>

<style>
.read-progress{position:fixed;left:0;right:0;top:88px;height:2px;z-index:49;pointer-events:none}
.read-progress span{display:block;height:100%;width:100%;background:var(--orange);transform:scaleX(0);transform-origin:0 50%}

/* Шапка */
.post-head{padding:34px 0 32px;max-width:1004px;margin-inline:auto}
.post-crumbs{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--muted);margin-bottom:36px}
.post-crumbs a{font-weight:700;color:var(--ink)}.post-crumbs a:hover{color:var(--orange)}
.post-head h1{font-size:clamp(28px,3.22vw,45px);line-height:1.02;letter-spacing:-.055em}
.post-lead{margin-top:26px;font-size:clamp(19px,1.6vw,23px);line-height:1.5;color:#454545;max-width:720px;letter-spacing:-.015em}
.post-byline{display:grid;grid-template-columns:repeat(4,auto);justify-content:start;gap:0;margin:40px 0 0;border-top:1.5px solid var(--ink)}
.post-byline div{padding:14px 36px 0 0}
.post-byline dt{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.post-byline dd{margin:4px 0 0;font-size:15px;font-weight:600}
.tone-steel .post-rubric{color:#616161}.tone-orange .post-rubric{color:#5a5a5a}.tone-sky .post-rubric{color:#585858}

.post-cover{margin:0 auto;max-width:940px}
.post-cover a{display:block;border-radius:18px;overflow:hidden;padding:18px;border:1px solid #1717170d}
.tone-steel .post-cover a{background:#e6e6e6}.tone-orange .post-cover a{background:#eaeaea}.tone-sky .post-cover a{background:#ededed}
.post-cover img{width:100%;height:auto;border-radius:10px;box-shadow:0 1px 2px #1717170f,0 8px 22px -14px #17171747;background:#ffffff}
.post-cover-photo a{padding:0}
.post-cover-photo img{aspect-ratio:2/1;object-fit:cover;object-position:70% 40%;border-radius:0;box-shadow:none}
.post-cover-ph{aspect-ratio:2/1;border-radius:18px}.b-img-ph{aspect-ratio:3/2}
.post-cover figcaption{font-size:12px;color:var(--muted);margin-top:10px}

/* Колонки */
.post-layout{display:grid;grid-template-columns:220px minmax(0,720px);justify-content:center;gap:64px;padding:38px 0 32px}
.post-toc{position:sticky;top:120px;align-self:start}
.post-toc-title{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:12px}
.post-toc ol{list-style:none;margin:0;padding:0;border-top:1.5px solid var(--ink)}
.post-toc a{display:block;gap:6px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.4;color:var(--muted);transition:color .2s,padding .25s}
.post-toc a span{font-weight:700;font-size:11px;padding-top:2px;font-variant-numeric:tabular-nums}
.post-toc a:hover{color:var(--ink)}
.post-toc a.is-active{color:var(--ink);font-weight:700;padding-left:6px}
.post-toc a.is-active span{color:var(--orange)}
.post-copy{margin-top:18px;padding:0;border:0;background:none;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
.post-copy:hover{color:var(--orange)}

/* Блоки */
.post-part{scroll-margin-top:120px}
.post-part+.post-part{margin-top:38px}
.post-part h2{display:block;font-size:clamp(26px,1.63vw,28px);line-height:1.15;padding-top:18px;border-top:1.5px solid var(--ink);margin-bottom:24px}
.post-num{font-size:14px;font-weight:700;letter-spacing:0;font-variant-numeric:tabular-nums}
.tone-steel .post-num{color:#616161}.tone-orange .post-num{color:#5a5a5a}.tone-sky .post-num{color:#585858}
.post-part > * + *{margin-top:22px}
.post-part > h2 + *{margin-top:0}
.b-p,.b-media-text p{font-size:18px;line-height:1.8;color:#353535;max-width:none}
.post-body :global(a:not([class])){color:var(--ink);font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;text-decoration-color:#afafaf;transition:text-decoration-color .2s,color .2s}
.post-body :global(a:not([class]):hover){color:#5a5a5a;text-decoration-color:var(--orange)}
.post-body :global(strong){font-weight:700;color:var(--ink)}

.b-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.b-list li{position:relative;padding:12px 0 12px 28px;border-bottom:1px solid var(--line);font-size:17px;line-height:1.6}
.b-list li:before{content:'—';position:absolute;left:0;color:var(--orange)}

.b-steps{list-style:none;margin:0;padding:0;counter-reset:st;display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1.5px solid var(--ink)}
.b-steps li{counter-increment:st;padding:16px 20px 4px 0}
.b-steps li+li{padding-left:20px;border-left:1px solid var(--line)}
.b-steps li:before{content:counter(st,decimal-leading-zero);display:block;font-size:34px;font-weight:600;letter-spacing:-.04em;line-height:1;margin-bottom:12px;color:transparent;-webkit-text-stroke:1px var(--ink)}
.b-steps strong{display:block;font-size:16px;margin-bottom:6px}
.b-steps span{display:block;font-size:14px;line-height:1.55;color:var(--muted)}

.b-quote{margin-top:36px !important;margin-bottom:14px;padding:0 0 0 28px;border-left:3px solid var(--orange)}
.b-quote p{font-size:clamp(24px,2.4vw,32px);line-height:1.25;letter-spacing:-.035em;font-weight:600;color:var(--ink);max-width:none}
.b-quote cite{display:block;margin-top:12px;font-style:normal;font-size:13px;color:var(--muted)}

.b-note{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:18px 0;border-top:1px solid var(--ink);border-bottom:1px solid var(--line)}
.b-note strong{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
.tone-steel .b-note strong{color:#616161}.tone-orange .b-note strong{color:#5a5a5a}.tone-sky .b-note strong{color:#585858}
.b-note p{font-size:15px;line-height:1.7;color:#454545;max-width:none}

.b-img{display:block;border-radius:12px;overflow:hidden;transition:opacity .2s}
.b-img:hover{opacity:.92}
.b-img img{width:100%;height:auto}
.b-img-screen{padding:12px;border:1px solid #1717170d}
.tone-steel .b-img-screen{background:#e6e6e6}.tone-orange .b-img-screen{background:#eaeaea}.tone-sky .b-img-screen{background:#ededed}
.b-img-screen img{border-radius:6px;box-shadow:0 1px 2px #1717170f,0 6px 16px -12px #17171747;background:#ffffff}
.b-img-photo img{aspect-ratio:3/2;object-fit:cover}
figure{margin:0}
figcaption{display:flex;gap:10px;margin-top:10px;font-size:13px;line-height:1.5;color:var(--muted)}
figcaption b{flex:none;color:var(--ink);font-weight:700}
.b-figure.b-wide{margin-top:36px !important;margin-bottom:12px}
.b-wide .b-img-photo img{aspect-ratio:16/8}
@media(min-width:1200px){.b-figure.b-wide{margin-right:calc((min(1280px,100vw - 96px) - 1004px)/-2)}}

.b-media{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1fr);gap:28px;align-items:start}
.b-media-right figure{order:2}
.b-media-text p+p{margin-top:16px}
.b-media-text p{font-size:17px}

.b-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}

.b-compare-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:12px}
.b-compare>div{display:grid;grid-template-columns:1fr 1fr;border-top:1.5px solid var(--ink)}
.b-compare section{padding:18px 22px 6px 0}
.b-compare section+section{padding-left:22px;border-left:1px solid var(--line)}
.b-compare span{display:block;font-size:44px;font-weight:600;line-height:1;letter-spacing:-.05em;margin-bottom:12px}
.b-compare section:first-child span{color:var(--steel)}.b-compare section+section span{color:var(--orange)}
.b-compare strong{display:block;font-size:17px;line-height:1.35;margin-bottom:8px}
.b-compare p{font-size:15px;line-height:1.6;color:var(--muted)}

.b-links{margin-top:40px !important;border-top:1.5px solid var(--ink)}
.b-links-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:14px 0 6px}
.b-links a{display:grid;grid-template-columns:150px 1fr auto;align-items:baseline;gap:16px;padding:16px 0;border-bottom:1px solid var(--line);transition:padding .3s}
.b-links-meta{font-size:12px;font-weight:700;color:var(--muted)}
.b-links-label{font-size:19px;font-weight:600;letter-spacing:-.02em;line-height:1.3}
.b-links-arrow{color:var(--orange);font-size:20px;transition:transform .3s}
.b-links a:hover{padding-left:8px}
.b-links a:hover .b-links-arrow{transform:translateX(6px)}

.post-end{margin-top:43px;padding-top:24px;border-top:1.5px solid var(--ink);display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap}
.post-end p{font-size:17px;color:#454545;max-width:440px}
.post-end a{font-size:clamp(26px,2.6vw,36px);font-weight:600;letter-spacing:-.04em;background:linear-gradient(var(--orange),var(--orange)) 0 100%/0 2px no-repeat;transition:background-size .4s}
.post-end a span{color:var(--orange)}
.post-end a:hover{background-size:100% 2px}

.post-more-head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:32px;padding-top:20px;border-top:1.5px solid var(--ink)}
.related{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}

@media(max-width:1100px){.post-layout{grid-template-columns:1fr;gap:0;padding-top:32px}.post-toc{position:static;margin-bottom:44px}}
@media(max-width:900px){.read-progress{top:72px}}
@media(max-width:760px){
  .post-head{padding:36px 0 28px}.post-byline{grid-template-columns:1fr 1fr}.post-byline div{padding-right:12px}
  .post-cover a{padding:10px;border-radius:14px}.post-cover-photo a{padding:0}.post-cover-photo img{aspect-ratio:4/3}
  .b-p,.b-media-text p{font-size:16px}.b-list li{font-size:15px}
  .b-media,.b-pair,.b-compare>div,.b-steps{grid-template-columns:1fr}
  .b-media-right figure{order:0}
  .b-steps li+li,.b-compare section+section{padding-left:0;border-left:0;border-top:1px solid var(--line)}
  .b-note{grid-template-columns:1fr;gap:6px}
  .b-links a{grid-template-columns:1fr auto;gap:4px 12px}.b-links-meta{grid-column:1/-1}.b-links-label{font-size:17px}
  .related{grid-template-columns:1fr;gap:16px}
}
</style>

<script>
  const bar=document.querySelector<HTMLElement>('[data-read-progress]')!;
  const body=document.querySelector<HTMLElement>('.post-body')!;
  function progress(){
    const r=body.getBoundingClientRect();
    const total=r.height-window.innerHeight*.6;
    const p=Math.min(1,Math.max(0,(-r.top+window.innerHeight*.3)/Math.max(total,1)));
    bar.style.transform=`scaleX(${p})`;
  }
  addEventListener('scroll',progress,{passive:true});addEventListener('resize',progress);progress();

  // Текущий раздел в оглавлении.
  const links=new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map(a=>[a.dataset.toc!,a]));
  const parts=[...document.querySelectorAll<HTMLElement>('[data-part]')];
  function activeToc(){
    let current=parts[0]?.id;
    for(const p of parts)if(p.getBoundingClientRect().top<window.innerHeight*.35)current=p.id;
    links.forEach((a,id)=>a.classList.toggle('is-active',id===current));
  }
  addEventListener('scroll',activeToc,{passive:true});activeToc();

  const copy=document.querySelector<HTMLButtonElement>('[data-copy-link]');
  copy?.addEventListener('click',async()=>{
    try{await navigator.clipboard.writeText(location.href);copy.textContent='Ссылка скопирована'}
    catch{copy.textContent='Скопируйте адрес из строки браузера'}
    setTimeout(()=>{copy.textContent='Скопировать ссылку'},2200);
  });
</script>
