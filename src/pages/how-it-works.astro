---
import PaymentInfo from '../components/PaymentInfo.astro';
import Base from '../layouts/BaseLayout.astro';import CabinetGuide from '../components/CabinetGuide.astro';import CTA from '../components/CTA.astro';
---
<Base title="Как работает ФотоКонтур — интерактивное демо"><section class="intro wrap"><h1>Рабочее пространство,<br/>которое можно<br/>попробовать.</h1><p class="lead">Ниже — настоящий прототип кабинета руководителя студии. Ходите по нему свободно или включите инструкцию: она по шагам покажет, как устроена работа.</p></section><section class="wrap demo-section"><CabinetGuide/></section><PaymentInfo/><CTA/></Base>

<style>.demo-section{padding:0 0 58px}@media(max-width:760px){.demo-section{padding-bottom:34px}}.tour-intro-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin-top:45px}.tour-intro-steps>div{border-top:1px solid var(--line);padding-top:22px}.tour-intro-steps span{font-size:12px;color:var(--steel)}.tour-intro-steps h3{font-size:22px;margin:14px 0}.tour-intro-steps p{font-size:14px;color:var(--muted)}@media(max-width:760px){.tour-intro-steps{grid-template-columns:1fr;gap:26px}}</style>
